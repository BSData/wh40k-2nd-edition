    <profile name="Shroud of Sanguinius" id="d9c4-ef88-ae93-7cb8" hidden="false" page="93" publicationId="308f-63b0-ee37-1c6b" typeId="cc8b-49d5-829c-bfaf" typeName="Wargear">
      <characteristics>
        <characteristic name="Special" typeId="f917-8cd8-7592-47dd">May be activated or deactivated at the start of any Blood Angel turn. When deactivated any Blood Angels within 12&quot; become subject to Frenzy. When reactivated the Blood Angels return to normal. The bearer themselves are not affected by Frenzy when deactivated.</characteristic>
      </characteristics>
    </profile>
