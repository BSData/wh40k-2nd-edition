    <selectionEntry name="Assassin" id="6d6a-c81b-bb34-7d18" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="3Support" id="1f9e-5466-35da-95e1" hidden="false" primary="true" targetId="b6e4-2c66-e404-b10a"/>
      </categoryLinks>
      <constraints>
        <constraint id="9125-8152-44ce-c3d3" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
      <rules>
        <rule name="Dodge" id="4be6-cbbc-974f-b573" hidden="false" page="8" publicationId="4e3f-569f-151e-9c5c">
          <description>4+ unmodified save from any attacks including psychic. 
If successfully dodged a blast template, place the model to the outside area of the template.</description>
        </rule>
        <rule name="Gas Weapons" id="2986-abb8-cfb1-e4ac" hidden="false" page="8" publicationId="4e3f-569f-151e-9c5c">
          <description>Cannot be harmed in any way by weapons that use the Choke, Scare, Hallucinogen, Toxin, or Virus effects. This does not include Tyranid poisons and venoms.</description>
        </rule>
        <rule name="Infiltration" id="f5dc-f370-bb1f-c0da" hidden="false" page="8" publicationId="4e3f-569f-151e-9c5c">
          <description>As per the rules on Pg.11 of the Warhammer Rulebook</description>
        </rule>
        <rule name="Leadership" id="2e5e-f64d-d620-300a" hidden="false" page="8" publicationId="4e3f-569f-151e-9c5c">
          <description>Can never be broken, automatically pass any Break test.
May never lead another unit and their Leadership can never be used by other units.
If attacked by a psychic power that calls for the Assassin to pass a Leadership test, then they must still do that test.</description>
        </rule>
        <rule name="Psycholoy" id="7a61-bdc8-7db5-74b2" hidden="false" page="8" publicationId="4e3f-569f-151e-9c5c">
          <description>Assassins are unaffected by the Psycholoy rules in the main Rulebook regardless of the source</description>
        </rule>
        <rule name="Vision" id="69d7-261e-5c41-e371" hidden="false" page="8" publicationId="4e3f-569f-151e-9c5c">
          <description>Not affected by gas or smoke weapons that normally obscure vision, although still affected by Blind grenades and missiles as normal.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup name="Assassin Type" id="05d4-8d08-eb6e-9e79" collective="false" hidden="false" import="true">
          <constraints>
            <constraint id="7bf7-371f-1f90-5ee8" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <entryLinks>
