    <selectionEntry name="Huge Claws" id="0935-5585-ed8f-efa3" collective="false" hidden="false" import="true" type="upgrade">
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
      <infoLinks>
