    <profile name="Fiends of Slaanesh" id="d69b-0ae3-a19b-1220" hidden="false" page="56" publicationId="02e1-3f69-7ae7-f5c5" typeId="219f-0faa-a2d8-f766" typeName="Unit">
      <characteristics>
