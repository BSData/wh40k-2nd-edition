    <selectionEntry name="Scorpion Tail" id="cc8c-27ef-185a-c531" hidden="false" import="true" type="upgrade">
      <infoLinks>
        <infoLink name="Scorpion Tail" id="684c-bb64-a748-5746" hidden="false" targetId="2ed4-32b5-5144-9ac8" type="profile"/>
      </infoLinks>
    </selectionEntry>
    <selectionEntry name="Plaguesword" id="68ce-d7ca-b107-b45c" hidden="false" import="true" type="upgrade">
      <infoLinks>
        <infoLink name="Plaguesword" id="55f3-067d-487b-2517" hidden="false" targetId="6b2f-a25c-767f-d36c" type="profile"/>
        <infoLink name="Parry" id="c045-bb06-4753-30fe" hidden="false" targetId="049d-3ed2-a1bf-86b0" type="rule"/>
      </infoLinks>
    </selectionEntry>
    <selectionEntry name="Plaguebearers" id="7e5b-7ccd-926d-7da0" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Chaos" id="7298-e995-77e2-5f17" hidden="false" primary="false" targetId="b373-19ca-9b61-1a4c"/>
        <categoryLink name="3Support" id="1d6f-e94c-22f3-6089" hidden="false" primary="true" targetId="b6e4-2c66-e404-b10a"/>
      </categoryLinks>
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
      <entryLinks>
        <entryLink name="Psyker" id="9d2f-bb21-89e3-50f9" collective="false" hidden="false" import="true" targetId="56e9-7608-b945-ac81" type="selectionEntry">
          <constraints>
            <constraint id="81d3-5270-210d-c1ef" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
          </constraints>
        </entryLink>
      </entryLinks>
      <infoLinks>
        <infoLink name="Cloud of Flies" id="7b53-7069-9a75-b0ee" hidden="false" targetId="1415-a56d-02ad-e195" type="rule"/>
        <infoLink name="Fear" id="6195-3708-ffee-65de" hidden="false" targetId="c7ef-dc7b-3ecc-91f5" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="Plaguebearers Psychic Level" id="2025-8cfd-c1c7-0eb9" hidden="false" page="96" publicationId="02e1-3f69-7ae7-f5c5">
          <description>Gain a psychic mastery level of 1 per five models, and one Nurgle Chaos power per five models</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Plaguebearer" id="ff8a-e6bf-a1a1-03f3" collective="false" hidden="false" import="true" type="model">
          <constraints>
            <constraint id="7cdc-2e1e-996e-c07c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="35"/>
          </costs>
          <entryLinks>
            <entryLink name="Daemonic Aura" id="50d9-4d07-c9a2-631b" hidden="false" import="true" targetId="8819-b35a-4ee3-2a06" type="selectionEntry">
              <constraints>
                <constraint id="2720-9517-ebe5-6cb5" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="1ff5-71b9-a77c-7815" field="selections" includeChildSelections="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
            </entryLink>
            <entryLink name="Plaguesword" id="a6f3-7fb0-8a09-5e4a" hidden="false" import="true" targetId="68ce-d7ca-b107-b45c" type="selectionEntry">
              <constraints>
                <constraint id="870a-0334-bc8a-204f" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
