      </characteristics>
    </profile>
    <profile name="Rod of Khorne" id="559c-15d7-4cab-c89b" hidden="false" typeId="cc8b-49d5-829c-bfaf" typeName="Wargear">
      <characteristics>
        <characteristic name="Special" typeId="f917-8cd8-7592-47dd">Any creature with psychic powers that is in base to base contact with Doombreed at the start of the psychic phase loses D3 wounds. No save of any type is allowed against this. 

In close combat can be used as an additional hand weapon, using Doombreeds Strength and save modifier (S8, -5 save)</characteristic>
      </characteristics>
    </profile>
    <profile name="Doombreed" id="f083-6a43-03fa-5026" hidden="false" typeId="219f-0faa-a2d8-f766" typeName="Unit">
      <characteristics>
        <characteristic name="Unit Type" typeId="49de-956f-8797-7436">Doombreed</characteristic>
        <characteristic name="M" typeId="4934-7872-3dd7-a8b6">6</characteristic>
        <characteristic name="WS" typeId="dc18-b600-96a9-a4a3">10</characteristic>
        <characteristic name="BS" typeId="f859-88a3-fdd3-b298">9</characteristic>
        <characteristic name="S" typeId="5916-04ef-0fd1-6557">7</characteristic>
        <characteristic name="T" typeId="2e7d-2383-f92f-16f9">8</characteristic>
        <characteristic name="W" typeId="ce31-f767-c572-72cc">8</characteristic>
