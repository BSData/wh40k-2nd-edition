        <characteristic name="LD" typeId="c751-ec1f-edb8-fd83">10</characteristic>
      </characteristics>
    </profile>
    <profile name="Foulspawn" id="8e14-75f7-d3fe-1207" hidden="false" page="140" publicationId="02e1-3f69-7ae7-f5c5" typeId="219f-0faa-a2d8-f766" typeName="Unit">
