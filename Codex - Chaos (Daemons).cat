        <characteristic name="LD" typeId="c751-ec1f-edb8-fd83">12</characteristic>
      </characteristics>
    </profile>
    <profile name="Doombreed Chaos Armour" id="b10f-9d74-10ff-2841" hidden="false" typeId="4657-2671-1065-d493" typeName="Armour">
      <characteristics>
        <characteristic name="Saving Throw" typeId="b439-323a-9cfe-6340">2+ (On 2D6)</characteristic>
        <characteristic name="Special" typeId="b7f1-73cd-d19d-26a6">Not negated by force weapons or psychic attacks, but regular modifiers apply</characteristic>
      </characteristics>
    </profile>
    <profile name="N&apos;Kari" id="5ba3-08bf-f91b-7ef3" hidden="false" page="140" publicationId="02e1-3f69-7ae7-f5c5" typeId="219f-0faa-a2d8-f766" typeName="Unit">
      <characteristics>
        <characteristic name="Unit Type" typeId="49de-956f-8797-7436">N&apos;kari</characteristic>
        <characteristic name="M" typeId="4934-7872-3dd7-a8b6">6</characteristic>
