                  <characteristics>
                    <characteristic name="Gift" typeId="4f30-c481-04f2-1326">Any enemy models attempting to fight the models in close combat have their Attacks characteristic reduced by -1</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Scream of Slaanesh" id="3980-208a-1bcd-be71" collective="false" hidden="false" import="true" page="69" publicationId="02e1-3f69-7ae7-f5c5" type="upgrade">
