            </modifier>
          </modifiers>
          <selectionEntries>
            <selectionEntry name="Allure of Slaanesh" id="890e-ddab-50f3-c5a0" collective="false" hidden="false" import="true" page="69" publicationId="02e1-3f69-7ae7-f5c5" type="upgrade">
              <constraints>
                <constraint id="b4c3-6cae-7296-fca3" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="20"/>
              </costs>
              <profiles>
                <profile name="Allure of Slaanesh" id="13dd-7c2b-baca-6558" hidden="false" page="69" typeId="bc42-75af-4a0c-de00" typeName="Chaos Rewards">
                  <characteristics>
                    <characteristic name="Gift" typeId="4f30-c481-04f2-1326">In close combat, enemy models must test against their Leadership on 3d6 to be able to strike this model.
If they fail the test then they fight normally, but if they win the combat they will not strike the model and the combat is treated as a draw. Once an enemy model has passed the test, it need not test again.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Gaze of Slaanesh" id="a70c-6764-4cf1-cabc" collective="false" hidden="false" import="true" page="69" publicationId="02e1-3f69-7ae7-f5c5" type="upgrade">
              <constraints>
                <constraint id="0089-4c6a-24ee-4199" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
