        <characteristic name="LD" typeId="c751-ec1f-edb8-fd83">10</characteristic>
      </characteristics>
    </profile>
    <profile name="Stream of Corruption" id="56cf-05a3-fecc-2d48" hidden="false" page="57" publicationId="02e1-3f69-7ae7-f5c5" typeId="cc8b-49d5-829c-bfaf" typeName="Wargear">
      <characteristics>
        <characteristic name="Special" typeId="f917-8cd8-7592-47dd">May unleash a stream during the shooting phase, using the Flamer template. Causes a S7 hit with a -2 save modifier and inflicts 1 Wound. May be used in close combat</characteristic>
      </characteristics>
    </profile>
    <profile name="Scorpion Tail" id="ec56-7eb4-1adf-1c25" hidden="false" page="56" publicationId="02e1-3f69-7ae7-f5c5" typeId="cc8b-49d5-829c-bfaf" typeName="Wargear">
      <characteristics>
        <characteristic name="Special" typeId="f917-8cd8-7592-47dd">If the Fiend wins close combat it gains 1 additional hit. This extra hit also has a +1 Strength bonus</characteristic>
      </characteristics>
    </profile>
    <profile name="Plaguesword" id="778e-0bea-50ce-064b" hidden="false" page="58" publicationId="02e1-3f69-7ae7-f5c5" typeId="cc8b-49d5-829c-bfaf" typeName="Wargear">
      <characteristics>
        <characteristic name="Special" typeId="f917-8cd8-7592-47dd">A wound from a Plaguesword will kill mortal creatures on a 4+ regardless of how many wounds they have. Allows the user to parry</characteristic>
      </characteristics>
    </profile>
    <profile name="Huge Claws" id="f6ac-41ab-6b7e-6d9e" hidden="false" page="55" publicationId="02e1-3f69-7ae7-f5c5" typeId="cc8b-49d5-829c-bfaf" typeName="Wargear">
      <characteristics>
        <characteristic name="Special" typeId="f917-8cd8-7592-47dd">The Daemonette&apos;s claws add +1 to its Strength in close combat. Not included in profile</characteristic>
      </characteristics>
    </profile>
    <profile name="Hellblade" id="765a-8623-e514-d45a" hidden="false" page="53" publicationId="02e1-3f69-7ae7-f5c5" typeId="cc8b-49d5-829c-bfaf" typeName="Wargear">
      <characteristics>
        <characteristic name="Special" typeId="f917-8cd8-7592-47dd">Hellblade adds +1 to the Bloodletters Strength in close combat and causes D3 wounds instead of 1.
Allows the Bloodletter to Parry</characteristic>
      </characteristics>
    </profile>
    <profile name="Collar of Khorne" id="6d04-4c53-765a-5aea" hidden="false" page="54" publicationId="02e1-3f69-7ae7-f5c5" typeId="cc8b-49d5-829c-bfaf" typeName="Wargear">
      <characteristics>
        <characteristic name="Special" typeId="f917-8cd8-7592-47dd">Force weapons lose their Strength bonus and do not wound the Flesh Hound automatically. Psyhcic attacks that target the wearer or include it in their area of effect are nullified and will not work.</characteristic>
      </characteristics>
    </profile>
    <profile name="Bloodthirster&apos;s Whip" id="5dbf-3b0a-3475-3957" hidden="false" page="52" publicationId="02e1-3f69-7ae7-f5c5" typeId="cc8b-49d5-829c-bfaf" typeName="Wargear">
      <characteristics>
        <characteristic name="Special" typeId="f917-8cd8-7592-47dd">At the start of close combat, a Bloodthirster can make a special attack with the whip against 1 enemy model in base contact. The model targeted must roll under its Initiative to avoid the whip (a 6 always fails). If it fails to avoid the attack it takes a S8 hit with a -5 save modifier. 
The whip counts as an additional hand weapon giving the Bloodthirster an extra Attack dice</characteristic>
      </characteristics>
    </profile>
    <profile name="Axe of Khorne" id="c29d-8541-753d-29b3" hidden="false" page="52" publicationId="02e1-3f69-7ae7-f5c5" typeId="cc8b-49d5-829c-bfaf" typeName="Wargear">
      <characteristics>
        <characteristic name="Special" typeId="f917-8cd8-7592-47dd">A hit from the Axe of Khorne causes D3 wounds instead of just 1. In addition, the axe adds +1 to the Strength in close combat</characteristic>
      </characteristics>
    </profile>
    <profile name="Blood Cannon" id="1b64-fb80-1b6d-f648" hidden="false" typeId="d8e8-6c66-f558-30ee" typeName="Weapon">
      <characteristics>
        <characteristic name="Short range" typeId="a108-ac67-8c42-6bbb">Template</characteristic>
        <characteristic name="Long Range" typeId="3acf-5fa0-de29-6094">Template</characteristic>
        <characteristic name="Short &apos;To Hit’" typeId="bbc0-6de5-4dfa-9328">-</characteristic>
        <characteristic name="Long &apos;To Hit’" typeId="10bb-0500-b03c-643c">-</characteristic>
        <characteristic name="Strength" typeId="e297-34fa-4b72-f0b6">6</characteristic>
        <characteristic name="Damage" typeId="8978-f9c3-8957-1481">D6</characteristic>
        <characteristic name="Save Modifier" typeId="53ec-cd58-3d6e-c00d">-4</characteristic>
        <characteristic name="Armour Penetration" typeId="0530-f4b7-b7db-de67">2D6+6</characteristic>
        <characteristic name="Special" typeId="9fb9-b2be-dfa5-713d">Blood Cannon</characteristic>
      </characteristics>
    </profile>
    <profile name="Plague Knife" id="9fdd-265e-9430-a44b" hidden="false" page="75" publicationId="02e1-3f69-7ae7-f5c5" typeId="d8e8-6c66-f558-30ee" typeName="Weapon">
      <characteristics>
        <characteristic name="Short range" typeId="a108-ac67-8c42-6bbb">CC Only</characteristic>
        <characteristic name="Long Range" typeId="3acf-5fa0-de29-6094">CC Only</characteristic>
        <characteristic name="Short &apos;To Hit’" typeId="bbc0-6de5-4dfa-9328"/>
        <characteristic name="Long &apos;To Hit’" typeId="10bb-0500-b03c-643c"/>
        <characteristic name="Strength" typeId="e297-34fa-4b72-f0b6">As User</characteristic>
        <characteristic name="Damage" typeId="8978-f9c3-8957-1481">1</characteristic>
        <characteristic name="Save Modifier" typeId="53ec-cd58-3d6e-c00d">As User</characteristic>
        <characteristic name="Armour Penetration" typeId="0530-f4b7-b7db-de67">Var</characteristic>
        <characteristic name="Special" typeId="9fb9-b2be-dfa5-713d">Plague  Knife</characteristic>
      </characteristics>
    </profile>
    <profile name="Daemonic Aura" id="fb47-0137-317d-f1e5" hidden="false" page="51" publicationId="02e1-3f69-7ae7-f5c5" typeId="4657-2671-1065-d493" typeName="Armour">
      <characteristics>
        <characteristic name="Saving Throw" typeId="b439-323a-9cfe-6340">4+</characteristic>
        <characteristic name="Special" typeId="b7f1-73cd-d19d-26a6">Cannot be modified. If hit by a psychic attack, or by a force weapon, it receives no saving throw.</characteristic>
      </characteristics>
    </profile>
    <profile name="Bloodthirster Chaos Armour" id="0407-cc46-9a9a-21ab" hidden="false" page="52" publicationId="02e1-3f69-7ae7-f5c5" typeId="4657-2671-1065-d493" typeName="Armour">
      <characteristics>
        <characteristic name="Saving Throw" typeId="b439-323a-9cfe-6340">3+ on 2D6</characteristic>
        <characteristic name="Special" typeId="b7f1-73cd-d19d-26a6">Still affected by modifiers unlike standard Daemonic Aura. However, Chaos Armour is not negated by force weapons or psychic attacks</characteristic>
      </characteristics>
    </profile>
    <profile name="Nurgle&apos;s Cloud of Flies" id="15d8-22c6-d9cc-b662" hidden="false" page="68" publicationId="02e1-3f69-7ae7-f5c5" typeId="bc42-75af-4a0c-de00" typeName="Chaos Rewards">
      <characteristics>
        <characteristic name="Gift" typeId="4f30-c481-04f2-1326">All enemy models in base to base suffer -1 modifier to their Weapon Skill, whether they are attacking the model with Cloud of Flies or another</characteristic>
      </characteristics>
    </profile>
    <profile name="Nurgle&apos;s Rot" id="ac29-e381-ea80-b1a1" hidden="false" page="68" publicationId="02e1-3f69-7ae7-f5c5" typeId="bc42-75af-4a0c-de00" typeName="Chaos Rewards">
      <characteristics>
        <characteristic name="Gift" typeId="4f30-c481-04f2-1326">After making close combat attacks, roll a D6 for each mortal enemy model in base to base. On a 6 they contract Nurgle&apos;s Rot and suffer a single wound. 
No saving throws of any kind are allowed against Nurgle&apos;s Rot - including fields, dodge, etc. This only applies to mortal foes and not other daemons, vehicles, Avatars etc</characteristic>
      </characteristics>
    </profile>
    <profile name="Praise of Khorne" id="4344-aabf-732c-2883" hidden="false" page="58" publicationId="02e1-3f69-7ae7-f5c5" typeId="bc42-75af-4a0c-de00" typeName="Chaos Rewards">
      <characteristics>
        <characteristic name="Gift" typeId="4f30-c481-04f2-1326">May reroll any failed armour saves. This only works on armour saves</characteristic>
      </characteristics>
    </profile>
