    <profile name="Steeds of Slaanesh" id="94f2-d515-8c19-dae2" hidden="false" page="56" publicationId="02e1-3f69-7ae7-f5c5" typeId="219f-0faa-a2d8-f766" typeName="Unit">
      <characteristics>
        <characteristic name="Unit Type" typeId="49de-956f-8797-7436">Steed</characteristic>
        <characteristic name="M" typeId="4934-7872-3dd7-a8b6">12</characteristic>
        <characteristic name="WS" typeId="dc18-b600-96a9-a4a3">3</characteristic>
        <characteristic name="BS" typeId="f859-88a3-fdd3-b298">0</characteristic>
        <characteristic name="S" typeId="5916-04ef-0fd1-6557">4</characteristic>
        <characteristic name="T" typeId="2e7d-2383-f92f-16f9">5</characteristic>
        <characteristic name="W" typeId="ce31-f767-c572-72cc">1</characteristic>
