    <profile name="Hellblade" id="7391-ac2f-e68b-e70e" hidden="false" page="53" publicationId="02e1-3f69-7ae7-f5c5" typeId="cc8b-49d5-829c-bfaf" typeName="Wargear">
      <characteristics>
        <characteristic name="Special" typeId="f917-8cd8-7592-47dd">A hit from the Bloodletter causes D3 wounds instead of just 1. In addition, the axe adds +1 to the Bloodletters Strength in close combat.
Allows the Bloodletter to Parry</characteristic>
      </characteristics>
    </profile>
    <profile name="Flesh Hound" id="c32c-7901-1bcf-5746" hidden="false" page="54" publicationId="02e1-3f69-7ae7-f5c5" typeId="219f-0faa-a2d8-f766" typeName="Unit">
      <characteristics>
        <characteristic name="Unit Type" typeId="49de-956f-8797-7436">Flesh Hound</characteristic>
        <characteristic name="M" typeId="4934-7872-3dd7-a8b6">10</characteristic>
        <characteristic name="WS" typeId="dc18-b600-96a9-a4a3">5</characteristic>
        <characteristic name="BS" typeId="f859-88a3-fdd3-b298">0</characteristic>
        <characteristic name="S" typeId="5916-04ef-0fd1-6557">5</characteristic>
        <characteristic name="T" typeId="2e7d-2383-f92f-16f9">4</characteristic>
        <characteristic name="W" typeId="ce31-f767-c572-72cc">2</characteristic>
        <characteristic name="I" typeId="a9b1-bae9-25d0-fdbf">6</characteristic>
