    <forceEntry name="Chaos" id="7428-ade3-bde5-7955" hidden="false">
      <categoryLinks>
        <categoryLink name="Support" id="9ea1-8d29-5f10-630c" hidden="false" targetId="db1a-73a1-08a2-0e88">
          <constraints>
            <constraint id="c05d-b719-2699-21a5" field="points" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="max" value="0"/>
            <constraint id="a249-08dd-2c10-861e" field="points" includeChildForces="true" includeChildSelections="true" percentValue="true" scope="roster" shared="true" type="max" value="25"/>
          </constraints>
          <modifierGroups>
            <modifierGroup type="and">
              <comment>When you have no points limit</comment>
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition childId="any" field="limit::points" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="lessThan" value="1"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
              <modifiers>
                <modifier field="c05d-b719-2699-21a5" type="set" value="-1"/>
              </modifiers>
            </modifierGroup>
            <modifierGroup type="and">
              <comment>When having a points limit</comment>
              <modifiers>
                <modifier field="c05d-b719-2699-21a5" type="increment" value="1">
                  <conditionGroups>
                    <conditionGroup type="and">
                      <conditions>
                        <condition childId="any" field="limit::points" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="atLeast" value="1"/>
                      </conditions>
                    </conditionGroup>
                  </conditionGroups>
                  <repeats>
                    <repeat childId="any" field="limit::points" includeChildForces="true" includeChildSelections="true" repeats="0.25" roundUp="false" scope="roster" shared="true" value="1"/>
                  </repeats>
                </modifier>
                <modifier field="a249-08dd-2c10-861e" type="set" value="-1">
                  <conditionGroups>
                    <conditionGroup type="and">
                      <conditions>
                        <condition childId="any" field="limit::points" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="atLeast" value="1"/>
                      </conditions>
                    </conditionGroup>
                  </conditionGroups>
                </modifier>
              </modifiers>
            </modifierGroup>
          </modifierGroups>
        </categoryLink>
