        <profile name="Kharn the Betrayer" id="9cae-07ff-fec4-69da" hidden="false" page="101" publicationId="02e1-3f69-7ae7-f5c5" typeId="219f-0faa-a2d8-f766" typeName="Unit">
          <characteristics>
            <characteristic name="Unit Type" typeId="49de-956f-8797-7436">Kharn</characteristic>
            <characteristic name="M" typeId="4934-7872-3dd7-a8b6">4</characteristic>
            <characteristic name="WS" typeId="dc18-b600-96a9-a4a3">9</characteristic>
            <characteristic name="BS" typeId="f859-88a3-fdd3-b298">7</characteristic>
            <characteristic name="S" typeId="5916-04ef-0fd1-6557">6</characteristic>
            <characteristic name="T" typeId="2e7d-2383-f92f-16f9">5</characteristic>
            <characteristic name="W" typeId="ce31-f767-c572-72cc">3(6)</characteristic>
            <characteristic name="I" typeId="a9b1-bae9-25d0-fdbf">7</characteristic>
            <characteristic name="A" typeId="e39a-b0ee-e6d1-e661">3</characteristic>
            <characteristic name="LD" typeId="c751-ec1f-edb8-fd83">10</characteristic>
          </characteristics>
        </profile>
        <profile name="Blood Fury of Khorne" id="9a7d-a44f-4aca-11be" hidden="false" page="101" publicationId="02e1-3f69-7ae7-f5c5" typeId="aa04-135c-b9c2-b9e7" typeName="Chaos Rewards">
          <characteristics>
            <characteristic name="Gift" typeId="7669-0cd9-797f-2e6d">6 Wounds (included in profile). If Kharn slays an enemy in close combat and there are no other enemy models within his follow-up move distance, he will attack the nearest model within 4&quot; instead, even if it is a friendly model. Fight out the close combat in subsequent phases just as if Kharn belonged to the opposing player. If Kharn slays a model and there is an enemy within 4&quot;, he may move up to attack it next. But if there are no enemy models, he will attack the nearest model again.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Unstoppable Attack" id="199c-e242-390f-46f8" hidden="false" page="101" publicationId="02e1-3f69-7ae7-f5c5">
          <description>Models in close combat with Kharn may not make any parries</description>
        </rule>
        <rule name="Impetuous" id="0408-c117-a224-b2be" hidden="false" page="101" publicationId="02e1-3f69-7ae7-f5c5">
          <description>Kharn&apos;s follow-up moves are increased to 4&quot; instead of the usual 2&quot;</description>
        </rule>
        <rule name="Kharn as Commander" id="bc3d-ae11-b7c0-2881" hidden="false" page="101" publicationId="02e1-3f69-7ae7-f5c5">
          <description>Kharn can only be the army commander if the force is worth 1000 points or less OR is compossed entirely of Khornze Bezerkers and daemons.</description>
        </rule>
      </rules>
