              <profiles>
                <profile name="Breathe Fire" id="2e1f-d8db-38a1-9243" hidden="false" page="68" typeId="aa04-135c-b9c2-b9e7" typeName="Chaos Rewards">
                  <characteristics>
                    <characteristic name="Gift" typeId="7669-0cd9-797f-2e6d">May attack in the shooting phase as if it were armed with a flamer. Treated exactly the same as any other weapon attack. May not use if in hand-to-hand combat</characteristic>
                  </characteristics>
                </profile>
