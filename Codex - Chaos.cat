    <profile name="Demagogue" id="37dd-f652-dbe6-d1fc" hidden="false" typeId="219f-0faa-a2d8-f766" typeName="Unit">
      <characteristics>
        <characteristic name="Unit Type" typeId="49de-956f-8797-7436">Demagogue</characteristic>
        <characteristic name="M" typeId="4934-7872-3dd7-a8b6">4</characteristic>
        <characteristic name="WS" typeId="dc18-b600-96a9-a4a3">5</characteristic>
        <characteristic name="BS" typeId="f859-88a3-fdd3-b298">5</characteristic>
        <characteristic name="S" typeId="5916-04ef-0fd1-6557">4</characteristic>
        <characteristic name="T" typeId="2e7d-2383-f92f-16f9">4</characteristic>
        <characteristic name="W" typeId="ce31-f767-c572-72cc">2</characteristic>
        <characteristic name="I" typeId="a9b1-bae9-25d0-fdbf">5</characteristic>
        <characteristic name="A" typeId="e39a-b0ee-e6d1-e661">2</characteristic>
        <characteristic name="LD" typeId="c751-ec1f-edb8-fd83">8</characteristic>
      </characteristics>
