    <profile name="Chaos Cauldron of Blood" id="3060-a53f-34c1-c140" hidden="false" page="datafax" typeId="371a-1ec9-2157-1eb6" typeName="Vehicle">
      <characteristics>
        <characteristic name="Slow Speed" typeId="7c52-da5f-7f1a-95fd">5</characteristic>
