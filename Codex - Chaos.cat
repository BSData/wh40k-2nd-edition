    <profile name="Nurgle&apos;s Rot" id="1922-0872-8350-4e4c" hidden="false" page="68" publicationId="02e1-3f69-7ae7-f5c5" typeId="aa04-135c-b9c2-b9e7" typeName="Chaos Rewards">
      <characteristics>
        <characteristic name="Gift" typeId="7669-0cd9-797f-2e6d">After making normal close combat attacks, roll a D6 for each mortal enemy model in base contact. On a 6+ they suffer a single wound with no saving throw of any kind allowed. Only applies to mortal foes, not vehicles, other daemons, etc.</characteristic>
      </characteristics>
    </profile>
    <profile name="Nurgle&apos;s Cloud of Flies" id="26a9-95d6-20e2-3bc5" hidden="false" page="68" publicationId="02e1-3f69-7ae7-f5c5" typeId="aa04-135c-b9c2-b9e7" typeName="Chaos Rewards">
      <characteristics>
        <characteristic name="Gift" typeId="7669-0cd9-797f-2e6d">All enemy models in base contact suffer a -1 to their Weapon Skill, whether they are attacking the model or not</characteristic>
      </characteristics>
    </profile>
    <profile name="Collar of Khorne" id="8ba2-8f8a-4c35-9c2a" hidden="false" page="68" publicationId="02e1-3f69-7ae7-f5c5" typeId="aa04-135c-b9c2-b9e7" typeName="Chaos Rewards">
      <characteristics>
        <characteristic name="Gift" typeId="7669-0cd9-797f-2e6d">Force weapons lose their Strength bonus and cannot wound the wearer automatically if he is a daemon, and psychic attacks that target the wearer or include it in their area of effect are nullified and will not work</characteristic>
      </characteristics>
    </profile>
    <profile name="Praise of Khorne" id="3de1-0ee7-4a90-88e8" hidden="false" page="58" publicationId="02e1-3f69-7ae7-f5c5" typeId="aa04-135c-b9c2-b9e7" typeName="Chaos Rewards">
      <characteristics>
        <characteristic name="Gift" typeId="7669-0cd9-797f-2e6d">May retake any failed armour save. Note that this reward will not work on any types of save other than armour saves</characteristic>
      </characteristics>
    </profile>
    <profile name="Chaos Terminator Armour" id="6c8c-438d-9db3-3404" hidden="false" page="72" publicationId="02e1-3f69-7ae7-f5c5" typeId="4657-2671-1065-d493" typeName="Armour">
      <characteristics>
        <characteristic name="Saving Throw" typeId="b439-323a-9cfe-6340">3+ save, using 2D6.</characteristic>
        <characteristic name="Special" typeId="b7f1-73cd-d19d-26a6"/>
      </characteristics>
    </profile>
    <profile name="Reaper Autocannon" id="e13c-69d4-f894-79d1" hidden="false" page="73" publicationId="02e1-3f69-7ae7-f5c5" typeId="d8e8-6c66-f558-30ee" typeName="Weapon">
      <characteristics>
        <characteristic name="Short range" typeId="a108-ac67-8c42-6bbb">20</characteristic>
        <characteristic name="Long Range" typeId="3acf-5fa0-de29-6094">40</characteristic>
        <characteristic name="Short &apos;To Hit’" typeId="bbc0-6de5-4dfa-9328">-</characteristic>
        <characteristic name="Long &apos;To Hit’" typeId="10bb-0500-b03c-643c">-</characteristic>
        <characteristic name="Strength" typeId="e297-34fa-4b72-f0b6">8</characteristic>
        <characteristic name="Damage" typeId="8978-f9c3-8957-1481">D6</characteristic>
