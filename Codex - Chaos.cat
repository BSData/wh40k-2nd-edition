        <characteristic name="T" typeId="2e7d-2383-f92f-16f9">3</characteristic>
        <characteristic name="W" typeId="ce31-f767-c572-72cc">1</characteristic>
        <characteristic name="I" typeId="a9b1-bae9-25d0-fdbf">6</characteristic>
