        <profile name="The Chirurgeon" id="0065-9453-bf14-096c" hidden="false" page="104" publicationId="02e1-3f69-7ae7-f5c5" typeId="cc8b-49d5-829c-bfaf" typeName="Wargear">
          <characteristics>
            <characteristic name="Special" typeId="f917-8cd8-7592-47dd">Grants Frenzon. +2 Attacks in close combat, which are added after the effects of any doubling via Frenzy. Immune to Toxin and Gas weapons. If wounded, Bile takes no wounds if he can roll greater than wounds suffered on 1 D6. A roll of a 6 will always negate any wounds, but cannot save him from a Vortex grenade, Distort cannon, Wraith cannon etc.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Fabius&apos; Characteristics" id="be1a-53bf-b39c-50c8" hidden="false" page="104" publicationId="02e1-3f69-7ae7-f5c5">
