            <profile name="Xyclos Needler" id="0a2b-87d8-8a4c-92f8" hidden="false" page="104" publicationId="02e1-3f69-7ae7-f5c5" typeId="d8e8-6c66-f558-30ee" typeName="Weapon">
              <characteristics>
                <characteristic name="Short range" typeId="a108-ac67-8c42-6bbb">12</characteristic>
