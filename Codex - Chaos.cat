  <profileTypes>
    <profileType name="Mark of Chaos" id="4fa6-d4f7-781c-53f9">
      <characteristicTypes>
        <characteristicType name="Special Rule" id="6299-cb13-a123-d9ec"/>
      </characteristicTypes>
    </profileType>
    <profileType name="Chaos Rewards" id="aa04-135c-b9c2-b9e7">
      <characteristicTypes>
        <characteristicType name="Gift" id="7669-0cd9-797f-2e6d"/>
