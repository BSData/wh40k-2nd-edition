    <profile name="Daemonic Aura" id="938e-6cf7-fdbe-7090" hidden="false" page="51" publicationId="02e1-3f69-7ae7-f5c5" typeId="4657-2671-1065-d493" typeName="Armour">
      <characteristics>
        <characteristic name="Saving Throw" typeId="b439-323a-9cfe-6340">4+</characteristic>
        <characteristic name="Special" typeId="b7f1-73cd-d19d-26a6">Cannot be modified. If hit by a psychic attack, or by a force weapon, it receives no saving throw.</characteristic>
      </characteristics>
    </profile>
    <profile name="Bloodthirster" id="639d-b94c-f7f5-b005" hidden="false" page="52" publicationId="02e1-3f69-7ae7-f5c5" typeId="219f-0faa-a2d8-f766" typeName="Unit">
      <characteristics>
        <characteristic name="Unit Type" typeId="49de-956f-8797-7436">Bloodthirster</characteristic>
        <characteristic name="M" typeId="4934-7872-3dd7-a8b6">6</characteristic>
        <characteristic name="WS" typeId="dc18-b600-96a9-a4a3">10</characteristic>
        <characteristic name="BS" typeId="f859-88a3-fdd3-b298">10</characteristic>
        <characteristic name="S" typeId="5916-04ef-0fd1-6557">8</characteristic>
        <characteristic name="T" typeId="2e7d-2383-f92f-16f9">7</characteristic>
        <characteristic name="W" typeId="ce31-f767-c572-72cc">10</characteristic>
        <characteristic name="I" typeId="a9b1-bae9-25d0-fdbf">8</characteristic>
        <characteristic name="A" typeId="e39a-b0ee-e6d1-e661">10</characteristic>
        <characteristic name="LD" typeId="c751-ec1f-edb8-fd83">10</characteristic>
      </characteristics>
    </profile>
    <profile name="Bloodthirster Chaos Armour" id="fd5a-580f-1062-6573" hidden="false" page="52" publicationId="02e1-3f69-7ae7-f5c5" typeId="4657-2671-1065-d493" typeName="Armour">
      <characteristics>
        <characteristic name="Saving Throw" typeId="b439-323a-9cfe-6340">3+ on 2D6</characteristic>
        <characteristic name="Special" typeId="b7f1-73cd-d19d-26a6">Still affected by modifiers unlike standard Daemonic Aura. However, Chaos Armour is not negated by force weapons or psychic attacks</characteristic>
      </characteristics>
    </profile>
    <profile name="Axe of Khorne" id="db36-3d0c-28a6-bc2f" hidden="false" page="52" publicationId="02e1-3f69-7ae7-f5c5" typeId="cc8b-49d5-829c-bfaf" typeName="Wargear">
      <characteristics>
        <characteristic name="Special" typeId="f917-8cd8-7592-47dd">A hit from the Axe of Khorne causes D3 wounds instead of just 1. In addition, the axe adds +1 to the Strength in close combat</characteristic>
      </characteristics>
    </profile>
    <profile name="Bloodthirster&apos;s Whip" id="6244-0f5e-561e-3ce2" hidden="false" page="52" publicationId="02e1-3f69-7ae7-f5c5" typeId="cc8b-49d5-829c-bfaf" typeName="Wargear">
      <characteristics>
        <characteristic name="Special" typeId="f917-8cd8-7592-47dd">At the start of close combat, a Bloodthirster can make a special attack with the whip against 1 enemy model in base contact. The model targeted must roll under its Initiative to avoid the whip (a 6 always fails). If it fails to avoid the attack it takes a S8 hit with a -5 save modifier. 
The whip counts as an additional hand weapon giving the Bloodthirster an extra Attack dice</characteristic>
      </characteristics>
    </profile>
    <profile name="Bloodletter" id="cae6-c475-5893-1be9" hidden="false" page="53" publicationId="02e1-3f69-7ae7-f5c5" typeId="219f-0faa-a2d8-f766" typeName="Unit">
