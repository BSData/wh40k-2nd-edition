                <profile name="Rod of Khorne" id="f523-4de9-29bd-49f5" hidden="false" typeId="cc8b-49d5-829c-bfaf" typeName="Wargear">
                  <characteristics>
                    <characteristic name="Special" typeId="f917-8cd8-7592-47dd">Any creature with psychic powers that is in base to base contact with Doombreed at the start of the psychic phase loses D3 wounds. No save of any type is allowed against this. 

In close combat can be used as an additional hand weapon, using Doombreeds Strength and save modifier (S8, -5 save)</characteristic>
                  </characteristics>
                </profile>
                <profile name="Doombreed Chaos Armour" id="5d77-f29d-e727-01e0" hidden="false" typeId="4657-2671-1065-d493" typeName="Armour">
                  <characteristics>
                    <characteristic name="Saving Throw" typeId="b439-323a-9cfe-6340">2+ (On 2D6)</characteristic>
                    <characteristic name="Special" typeId="b7f1-73cd-d19d-26a6">Not negated by force weapons or psychic attacks, but regular modifiers apply</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Praise of Khrone" id="7016-0108-1106-799c" hidden="false">
                  <description>Can retake any failed armour save.</description>
                </rule>
              </rules>
