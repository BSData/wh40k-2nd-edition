        <selectionEntry name="The Staff of Ulthamar" id="2194-50b0-222d-63e6" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="3ffc-162b-2571-9718" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
