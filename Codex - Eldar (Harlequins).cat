    <selectionEntryGroup name="Vehicle Wargear Cards" id="6526-cf18-5345-1050" collective="false" hidden="false" import="true">
      <entryLinks>
        <entryLink name="Wargear Cards (Vehicle - Generic)" id="85f1-cae1-6f28-60e4" collective="false" hidden="false" import="true" targetId="52d8-9a1c-a258-0ed7" type="selectionEntryGroup"/>
      </entryLinks>
      <selectionEntryGroups>
        <selectionEntryGroup name="Wargear Cards (Vehicle - Eldar)" id="445e-51d0-e4be-fa65" collective="false" hidden="false" import="true">
          <selectionEntries>
            <selectionEntry name="Crystalline Web" id="490f-2cae-cfd6-4454" collective="false" hidden="false" import="true" publicationId="71ba-82e2-d83c-d33d" type="upgrade">
              <costs>
                <cost name="pts" typeId="points" value="25"/>
              </costs>
              <profiles>
                <profile name="Crystalline Web" id="7a6e-de39-18e4-1aeb" hidden="false" publicationId="71ba-82e2-d83c-d33d" typeId="cc8b-49d5-829c-bfaf" typeName="Wargear">
                  <characteristics>
                    <characteristic name="Special" typeId="f917-8cd8-7592-47dd">Apply to any location on the vehicle. May purchase multiple times (1x for each vehicle part)
When the vehicle is penetrated on a section with the web roll on the Crystalline Web table instead of the normal damage for that location</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Crystalline Web Damage Table" id="d9fe-050f-a768-44c7" hidden="false" publicationId="71ba-82e2-d83c-d33d">
                  <description>1-2: Vehicle is unaffected
3: Any weapons associated with the penetrated location may not fire during your next turn. No further effects
4-5: Roll a D3 on the penetrated location&apos;s damage table. The web protecting the location is destroyed
6: Roll a D6 on the penetrated location&apos;s damage table. The web protecting the location is destroyed</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry name="Psycho-Sonic Screamers" id="953c-3e7f-4bf0-6cce" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="c50f-a4dc-47aa-27e7" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="20"/>
              </costs>
              <infoLinks>
                <infoLink name="Terror" id="dfa3-e0d6-3259-82ed" hidden="false" targetId="05e0-cd40-2d9e-a9f9" type="rule"/>
              </infoLinks>
              <modifiers>
                <modifier field="hidden" type="set" value="true">
                  <conditionGroups>
                    <conditionGroup type="and">
                      <conditions>
                        <condition childId="9187-ca83-9433-d2c7" childName="Skimmer/Bike" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="notInstanceOf" value="0"/>
                      </conditions>
                    </conditionGroup>
                  </conditionGroups>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Psycho-Sonic Screamers" id="1fdf-7b16-cc6a-4715" hidden="false" typeId="cc8b-49d5-829c-bfaf" typeName="Wargear">
                  <characteristics>
                    <characteristic name="Special" typeId="f917-8cd8-7592-47dd">Vehicle causes Terror</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Talons" id="52c7-7633-d791-c062" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="f0db-83ce-3f59-521d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="30"/>
              </costs>
              <modifiers>
                <modifier field="points" type="increment" value="30">
                  <conditionGroups>
                    <conditionGroup type="or">
                      <conditions>
                        <condition childId="d89d-0f46-9510-3f43" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="instanceOf" value="1"/>
                        <condition childId="12dd-3add-ff88-76a5" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="instanceOf" value="1"/>
                      </conditions>
                    </conditionGroup>
                  </conditionGroups>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Talons" id="c7fe-4c4e-4819-264d" hidden="false" publicationId="71ba-82e2-d83c-d33d" typeId="cc8b-49d5-829c-bfaf" typeName="Wargear">
                  <characteristics>
                    <characteristic name="Special" typeId="f917-8cd8-7592-47dd">Talons shoot automatically before close combat attacks against the vehicle are worked out. Roll a D6 for each model in hand to hand combat with the vehicle. On a 4+ the model is hit. If a hit is scored roll a D6. If the score is equal to or more than the target&apos;s Toughness then it suffers 1 Wound with a -2 save modifier.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Crystal Targeting Matrix" id="59fb-5af2-4f37-69d0" collective="false" hidden="false" import="true" type="upgrade">
              <costs>
                <cost name="pts" typeId="points" value="5"/>
              </costs>
              <profiles>
                <profile name="Crystal Targeting Matrix" id="f91c-f262-a709-f7ac" hidden="false" typeId="cc8b-49d5-829c-bfaf" typeName="Wargear">
                  <characteristics>
                    <characteristic name="Special" typeId="f917-8cd8-7592-47dd">Ignore all to hit modifiers for firing at fast moving targets</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Holo-Field" id="9636-92c5-d178-8749" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="8333-39f1-0991-d0ce" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="35"/>
              </costs>
              <profiles>
                <profile name="Holo-Field" id="597c-6474-7692-c326" hidden="false" typeId="cc8b-49d5-829c-bfaf" typeName="Wargear">
                  <characteristics>
                    <characteristic name="Special" typeId="f917-8cd8-7592-47dd">As long as the vehicle is moving, all shots fired at it suffer an additional -1 to hit. If the vehicle comes to a halt or makes a pop up attack then it does not benefit from its holo-field</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Spirit Stone" id="961f-5815-1607-6350" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="c12c-661c-b6d7-14cd" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="15"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="true">
                  <conditions>
                    <condition childId="12dd-3add-ff88-76a5" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="instanceOf" value="0"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Spirit Stone" id="5daa-f591-bf9d-17b8" hidden="false" publicationId="71ba-82e2-d83c-d33d" typeId="cc8b-49d5-829c-bfaf" typeName="Wargear">
                  <characteristics>
                    <characteristic name="Special" typeId="f917-8cd8-7592-47dd">If the vehicle is assaulted psychically, then the attack will be nullified on a 6+. In addition, if one of the crew is killed by any means, then the spirit stone takes over with exactly the same profile as an Eldar Guardian. If the dead crew member is hit again, then the spirit stone is hit instead. It has a Toughness of 4 and 1 Wound.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Spectral Shield" id="99cb-50c8-487d-3fbf" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="2ce3-0128-6762-9949" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="15"/>
              </costs>
              <profiles>
                <profile name="Spectral Shield" id="c03b-4b13-27d0-492f" hidden="false" typeId="cc8b-49d5-829c-bfaf" typeName="Wargear">
                  <characteristics>
                    <characteristic name="Special" typeId="f917-8cd8-7592-47dd">If the vehicle is hit by a laser weapon, the Eldar player rolls a D6 and subtracts the score from the armour penetration roll</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Vectored Engines" id="6c13-0591-4829-3451" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="afb0-9777-a044-89d2" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="25"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="true">
                  <conditionGroups>
                    <conditionGroup type="or">
                      <conditions>
                        <condition childId="d89d-0f46-9510-3f43" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="instanceOf" value="1"/>
                        <condition childId="12dd-3add-ff88-76a5" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="instanceOf" value="1"/>
                      </conditions>
                    </conditionGroup>
                  </conditionGroups>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Vectored Engines" id="0d0f-b02d-fae8-f6bd" hidden="false" typeId="cc8b-49d5-829c-bfaf" typeName="Wargear">
                  <characteristics>
                    <characteristic name="Special" typeId="f917-8cd8-7592-47dd">A vehicle fitting with vectored engines may take double the number of turns it is normally allowed to make</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
