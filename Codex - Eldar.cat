                <characteristic name="Short &apos;To Hit’" typeId="bbc0-6de5-4dfa-9328">-</characteristic>
                <characteristic name="Long &apos;To Hit’" typeId="10bb-0500-b03c-643c">-</characteristic>
                <characteristic name="Strength" typeId="e297-34fa-4b72-f0b6">8</characteristic>
                <characteristic name="Damage" typeId="8978-f9c3-8957-1481">D3</characteristic>
                <characteristic name="Save Modifier" typeId="53ec-cd58-3d6e-c00d">-6</characteristic>
                <characteristic name="Armour Penetration" typeId="0530-f4b7-b7db-de67">D6+D20+D3+8</characteristic>
                <characteristic name="Special" typeId="9fb9-b2be-dfa5-713d">Parry</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Witch Blade" id="3fea-382d-349f-2013" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="d71a-3eb5-59d4-0eba" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="15"/>
          </costs>
          <infoLinks>
            <infoLink name="Close Combat" id="f6a0-f28a-7fe9-d880" hidden="false" targetId="c494-c170-605c-8959" type="rule"/>
          </infoLinks>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition childId="56e9-7608-b945-ac81" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="notEqualTo" value="1"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Witch Blade" id="ef17-42fb-4eb1-187f" hidden="false" typeId="cc8b-49d5-829c-bfaf" typeName="Wargear">
              <characteristics>
                <characteristic name="Special" typeId="f917-8cd8-7592-47dd">At the end of the psychic phase, up to two unused Force Cards may be stored in the Blade instead of being placed in the discard pile. The stored Force Cards may be retrieved and used in subsequent psychic phases. In hand-to-hand combat, the Blade increases the wielder‘s Strength by a number equal to his Mastery Level and wounds Daemons automatically with no save possible. The wielder may also expend a stored Force Card to gain an extra +2 Strength and –2 armour save in hand-to-hand combat. May also be used to parry. See the weapon profile for more information.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Bright Lance" id="0640-eaec-5bf9-e4f5" hidden="false" import="true" publicationId="71ba-82e2-d83c-d33d" type="upgrade">
          <constraints>
            <constraint id="8c1b-ad3d-d4f4-d953" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="40"/>
          </costs>
          <profiles>
            <profile name="Bright Lance" id="8fd0-8d6f-c217-5190" hidden="false" typeId="d8e8-6c66-f558-30ee" typeName="Weapon">
              <characteristics>
                <characteristic name="Short range" typeId="a108-ac67-8c42-6bbb">12</characteristic>
                <characteristic name="Long Range" typeId="3acf-5fa0-de29-6094">36</characteristic>
                <characteristic name="Short &apos;To Hit’" typeId="bbc0-6de5-4dfa-9328">+1</characteristic>
                <characteristic name="Long &apos;To Hit’" typeId="10bb-0500-b03c-643c">-</characteristic>
                <characteristic name="Strength" typeId="e297-34fa-4b72-f0b6">9</characteristic>
                <characteristic name="Damage" typeId="8978-f9c3-8957-1481">D8</characteristic>
                <characteristic name="Save Modifier" typeId="53ec-cd58-3d6e-c00d">-6</characteristic>
                <characteristic name="Armour Penetration" typeId="0530-f4b7-b7db-de67">8+D6+D8</characteristic>
                <characteristic name="Special" typeId="9fb9-b2be-dfa5-713d"/>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Vehicle Wargear Cards" id="571e-75d5-7836-487d" collective="false" hidden="false" import="true">
      <entryLinks>
        <entryLink name="Wargear Cards (Vehicle - Generic)" id="0f45-b5d3-fdc4-da60" collective="false" hidden="false" import="true" targetId="52d8-9a1c-a258-0ed7" type="selectionEntryGroup"/>
      </entryLinks>
      <selectionEntryGroups>
        <selectionEntryGroup name="Wargear Cards (Vehicle - Eldar)" id="a825-ca10-bd7d-4f5f" collective="false" hidden="false" import="true">
          <selectionEntries>
            <selectionEntry name="Crystalline Web" id="ac88-6401-e476-266d" collective="false" hidden="false" import="true" publicationId="71ba-82e2-d83c-d33d" type="upgrade">
              <costs>
                <cost name="pts" typeId="points" value="25"/>
              </costs>
              <profiles>
                <profile name="Crystalline Web" id="67a3-77e0-bc04-d337" hidden="false" publicationId="71ba-82e2-d83c-d33d" typeId="cc8b-49d5-829c-bfaf" typeName="Wargear">
                  <characteristics>
                    <characteristic name="Special" typeId="f917-8cd8-7592-47dd">Apply to any location on the vehicle. May purchase multiple times (1x for each vehicle part)
When the vehicle is penetrated on a section with the web roll on the Crystalline Web table instead of the normal damage for that location</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Crystalline Web Damage Table" id="18fd-fcee-b6a7-ea32" hidden="false" publicationId="71ba-82e2-d83c-d33d">
                  <description>1-2: Vehicle is unaffected
3: Any weapons associated with the penetrated location may not fire during your next turn. No further effects
4-5: Roll a D3 on the penetrated location&apos;s damage table. The web protecting the location is destroyed
6: Roll a D6 on the penetrated location&apos;s damage table. The web protecting the location is destroyed</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry name="Psycho-Sonic Screamers" id="77d9-fe04-480d-8a36" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="9593-da9d-dc3f-477e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="20"/>
              </costs>
              <infoLinks>
                <infoLink name="Terror" id="95a3-c775-fb99-02d5" hidden="false" targetId="05e0-cd40-2d9e-a9f9" type="rule"/>
              </infoLinks>
              <modifiers>
                <modifier field="hidden" type="set" value="true">
                  <conditionGroups>
                    <conditionGroup type="and">
                      <conditions>
                        <condition childId="67c5-7ec8-a070-634b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="notInstanceOf" value="0"/>
                        <condition childId="ea08-c248-0463-9d85" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="notInstanceOf" value="0"/>
                        <condition childId="6b9c-f8ae-1c7b-ef26" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="notInstanceOf" value="0"/>
                        <condition childId="3096-5f11-0f43-2ab0" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="notInstanceOf" value="0"/>
                        <condition childId="ce9c-8d5f-4951-2427" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="notInstanceOf" value="0"/>
                        <condition childId="5943-bd5c-e0a1-518a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="notInstanceOf" value="0"/>
                      </conditions>
                    </conditionGroup>
                  </conditionGroups>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Psycho-Sonic Screamers" id="f65e-9ff6-58b2-b6d5" hidden="false" typeId="cc8b-49d5-829c-bfaf" typeName="Wargear">
                  <characteristics>
                    <characteristic name="Special" typeId="f917-8cd8-7592-47dd">Vehicle causes Terror</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Talons" id="ab34-1036-b218-0f09" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="11ce-4079-ab18-d3bd" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="30"/>
              </costs>
              <modifiers>
                <modifier field="points" type="increment" value="30">
                  <conditionGroups>
                    <conditionGroup type="or">
                      <conditions>
                        <condition childId="d89d-0f46-9510-3f43" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="instanceOf" value="1"/>
                        <condition childId="12dd-3add-ff88-76a5" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="instanceOf" value="1"/>
                      </conditions>
                    </conditionGroup>
                  </conditionGroups>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Talons" id="dd29-802e-96fe-e7db" hidden="false" publicationId="71ba-82e2-d83c-d33d" typeId="cc8b-49d5-829c-bfaf" typeName="Wargear">
                  <characteristics>
                    <characteristic name="Special" typeId="f917-8cd8-7592-47dd">Talons shoot automatically before close combat attacks against the vehicle are worked out. Roll a D6 for each model in hand to hand combat with the vehicle. On a 4+ the model is hit. If a hit is scored roll a D6. If the score is equal to or more than the target&apos;s Toughness then it suffers 1 Wound with a -2 save modifier.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Crystal Targeting Matrix" id="aa24-fe42-ec9a-24f4" collective="false" hidden="false" import="true" type="upgrade">
              <costs>
                <cost name="pts" typeId="points" value="5"/>
              </costs>
              <profiles>
                <profile name="Crystal Targeting Matrix" id="6ffe-4c35-617c-f301" hidden="false" typeId="cc8b-49d5-829c-bfaf" typeName="Wargear">
                  <characteristics>
                    <characteristic name="Special" typeId="f917-8cd8-7592-47dd">Ignore all to hit modifiers for firing at fast moving targets</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Holo-Field" id="32a2-6b9c-5e9c-78f9" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="2589-74bc-c137-faeb" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="35"/>
              </costs>
              <profiles>
                <profile name="Holo-Field" id="428a-9ef9-a0cc-d2a7" hidden="false" typeId="cc8b-49d5-829c-bfaf" typeName="Wargear">
                  <characteristics>
                    <characteristic name="Special" typeId="f917-8cd8-7592-47dd">As long as the vehicle is moving, all shots fired at it suffer an additional -1 to hit. If the vehicle comes to a halt or makes a pop up attack then it does not benefit from its holo-field</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Spirit Stone" id="1555-2146-9a72-ab27" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="503c-665e-8b60-5b1b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="15"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="true">
                  <conditions>
                    <condition childId="12dd-3add-ff88-76a5" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="instanceOf" value="0"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Spirit Stone" id="5d5c-04e9-1399-89a0" hidden="false" publicationId="71ba-82e2-d83c-d33d" typeId="cc8b-49d5-829c-bfaf" typeName="Wargear">
                  <characteristics>
                    <characteristic name="Special" typeId="f917-8cd8-7592-47dd">If the vehicle is assaulted psychically, then the attack will be nullified on a 6+. In addition, if one of the crew is killed by any means, then the spirit stone takes over with exactly the same profile as an Eldar Guardian. If the dead crew member is hit again, then the spirit stone is hit instead. It has a Toughness of 4 and 1 Wound.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Spectral Shield" id="c17f-a514-a0b3-6289" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="fa83-67c8-b989-f63a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="15"/>
              </costs>
              <profiles>
                <profile name="Spectral Shield" id="6d14-71ad-4335-21a6" hidden="false" typeId="cc8b-49d5-829c-bfaf" typeName="Wargear">
                  <characteristics>
                    <characteristic name="Special" typeId="f917-8cd8-7592-47dd">If the vehicle is hit by a laser weapon, the Eldar player rolls a D6 and subtracts the score from the armour penetration roll</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Vectored Engines" id="efec-e357-0f5a-4453" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="660e-8582-1e6e-9baa" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="25"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="true">
                  <conditionGroups>
                    <conditionGroup type="or">
                      <conditions>
                        <condition childId="d89d-0f46-9510-3f43" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="instanceOf" value="1"/>
                        <condition childId="12dd-3add-ff88-76a5" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="instanceOf" value="1"/>
                      </conditions>
                    </conditionGroup>
                  </conditionGroups>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Vectored Engines" id="f5ed-ab4e-75cf-5608" hidden="false" typeId="cc8b-49d5-829c-bfaf" typeName="Wargear">
                  <characteristics>
                    <characteristic name="Special" typeId="f917-8cd8-7592-47dd">A vehicle fitting with vectored engines may take double the number of turns it is normally allowed to make</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
