                <profile name="Fast Shot" id="7f4e-5c09-0c60-e23b" hidden="false" page="50" publicationId="71ba-82e2-d83c-d33d" typeId="acfa-400e-e0d9-a9fb" typeName="Exarch Powers">
                  <characteristics>
                    <characteristic name="Exarch Power" typeId="c400-873f-536b-90d7">May shoot twice in the shooting phase. May fire at the same target or two separate targets</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
