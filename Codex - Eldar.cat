              <profiles>
                <profile name="Mighty Strike" id="ffbe-d4b0-cd91-be2b" hidden="false" page="50" publicationId="71ba-82e2-d83c-d33d" typeId="acfa-400e-e0d9-a9fb" typeName="Exarch Powers">
                  <characteristics>
                    <characteristic name="Exarch Power" typeId="c400-873f-536b-90d7">If the Exarch inflicts 2 or more hits then he may choose to exchange all hits for a single hit with a Strength bonus. The bonus equals +1 for each extra hit scored, so you could excahnge 2 S4 hits for a single S5 hit, or 3 S4 hits for a single S6 hit, and so on</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
