                  <characteristics>
                    <characteristic name="Exarch Power" typeId="c400-873f-536b-90d7">Can parry melee attacks even if not using a weapon with parry. May force the enemy to re-roll up to two attack dice when parrying rather than just one.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Mighty Strike" id="9678-a4ca-6614-88e3" collective="false" hidden="false" import="true" type="upgrade">
