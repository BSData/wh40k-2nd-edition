        <selectionEntry name="The Staff of Ulthamar" id="6de2-72ab-49f8-0137" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="2498-3b50-5112-2f6a" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
