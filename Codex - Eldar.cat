    <selectionEntryGroup name="Exarch Warrior Powers" id="73d1-83d1-d400-8237" collective="false" hidden="false" import="true">
      <selectionEntries>
        <selectionEntry name="Crack Shot" id="6164-1cca-d065-789b" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="9c1a-65ca-36d5-4194" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="15"/>
          </costs>
          <profiles>
            <profile name="Crack Shot" id="8385-5771-6af7-35cf" hidden="false" page="50" publicationId="71ba-82e2-d83c-d33d" typeId="acfa-400e-e0d9-a9fb" typeName="Exarch Powers">
              <characteristics>
                <characteristic name="Exarch Power" typeId="c400-873f-536b-90d7">+1 to hit when shooting
May fire at Extreme range, adding half the weapons range onto the usual maximum range. 
When doing so the same to hit for long range shots apply and the +1 for Crack Shot does not get added</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Turn Aside Blow" id="4a4a-b631-69b0-ed1b" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="0fb9-52a2-8ccc-5439" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="5"/>
          </costs>
          <infoLinks>
            <infoLink name="Parry" id="ecff-4d52-7ec1-b024" hidden="false" targetId="049d-3ed2-a1bf-86b0" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Turn Aside Blow" id="0728-d49a-ef31-e42d" hidden="false" page="50" publicationId="71ba-82e2-d83c-d33d" typeId="acfa-400e-e0d9-a9fb" typeName="Exarch Powers">
              <characteristics>
                <characteristic name="Exarch Power" typeId="c400-873f-536b-90d7">Can parry melee attacks even if not using a weapon with parry. May force the enemy to re-roll up to two attack dice when parrying rather than just one.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Disarm" id="b82c-ef32-cf42-68fe" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="5696-4a76-cb08-d373" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="5"/>
          </costs>
          <profiles>
            <profile name="Disarm" id="d4d2-f649-bc49-1d7f" hidden="false" page="50" publicationId="71ba-82e2-d83c-d33d" typeId="acfa-400e-e0d9-a9fb" typeName="Exarch Powers">
              <characteristics>
                <characteristic name="Exarch Power" typeId="c400-873f-536b-90d7">If an Exarch wins close combat, then he may disarm his enemy rather than strike any hits that turn. The Exarch cauases no hits but the enemy automatically loses one weapon of the Exarch&apos;s choice. That weapon counts as being destroyed.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Crushing Blow" id="1670-e9f3-0c65-da69" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="b538-24f0-ed19-8c7b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="5"/>
          </costs>
          <profiles>
            <profile name="Crushing Blow" id="4f92-b8a0-dcfd-115d" hidden="false" page="50" publicationId="71ba-82e2-d83c-d33d" typeId="acfa-400e-e0d9-a9fb" typeName="Exarch Powers">
              <characteristics>
                <characteristic name="Exarch Power" typeId="c400-873f-536b-90d7">+1 Strength bonus in close combat. This applies to the Exarch&apos;s own Strength and also any Strength value of the close combat weapon they are using</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Bounding Leap" id="2607-d6ec-9bcb-9b15" collective="false" hidden="false" import="true" publicationId="71ba-82e2-d83c-d33d" type="upgrade">
          <constraints>
            <constraint id="d3d5-e10d-0e51-196d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="10"/>
          </costs>
          <profiles>
            <profile name="Bounding Leap" id="19de-587f-7068-a5db" hidden="false" page="50" publicationId="71ba-82e2-d83c-d33d" typeId="cc8b-49d5-829c-bfaf" typeName="Wargear">
              <characteristics>
                <characteristic name="Special" typeId="f917-8cd8-7592-47dd">May leap 4&quot; in addition to regular movement during the move phase. Can be used when charging as well. Can only leap once during the turn.
Can use the leap to jump over any model-high obstacle without penalty, including enemy models. 
Can leap out of close combat at the end of any close combat phase without suffering any penalty</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Battle Fortune" id="f998-8e3a-bde4-fea9" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="722a-3114-7da2-8311" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="10"/>
          </costs>
          <profiles>
            <profile name="Battle Fortune" id="aec6-e455-211c-a11d" hidden="false" page="50" publicationId="71ba-82e2-d83c-d33d" typeId="cc8b-49d5-829c-bfaf" typeName="Wargear">
              <characteristics>
                <characteristic name="Special" typeId="f917-8cd8-7592-47dd">May re-roll any failed saving throw for Exarch armour. Does not apply for any other save types</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Resolve" id="1210-cd0d-b4b4-e345" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="05b8-f4a0-f7ad-71dc" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="10"/>
          </costs>
          <profiles>
            <profile name="Resolve" id="4787-52a9-27c6-e00b" hidden="false" page="50" publicationId="71ba-82e2-d83c-d33d" typeId="acfa-400e-e0d9-a9fb" typeName="Exarch Powers">
              <characteristics>
                <characteristic name="Exarch Power" typeId="c400-873f-536b-90d7">Immune to all psychology and need never take a Break test</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Stealth" id="217c-e3e8-744e-1cd9" collective="false" hidden="false" import="true" page="50" publicationId="71ba-82e2-d83c-d33d" type="upgrade">
          <constraints>
            <constraint id="d398-306a-6bf1-31d6" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="10"/>
          </costs>
          <profiles>
            <profile name="Stealth" id="e541-2a2c-0493-c433" hidden="false" page="50" publicationId="71ba-82e2-d83c-d33d" typeId="acfa-400e-e0d9-a9fb" typeName="Exarch Powers">
              <characteristics>
                <characteristic name="Exarch Power" typeId="c400-873f-536b-90d7">Any enemy shooting at short range suffer -1 to hit, and -2 at long range</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
