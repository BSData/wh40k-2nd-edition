          <profiles>
            <profile name="The Mask of Jain Zar" id="3b8c-2443-614f-9072" hidden="false" typeId="cc8b-49d5-829c-bfaf" typeName="Wargear">
              <characteristics>
                <characteristic name="Special" typeId="f917-8cd8-7592-47dd">An enemy charged by the wearer may not fire on Overwatch. During the first round of close combat, when the Eldar charges, his opponent rolls no Attack Dice. In the second round of combat the enemy must roll a 4+ on D6 to escape the mask‘s effect — failure means that he rolls no dice on that turn, either.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
