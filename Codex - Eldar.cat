                <characteristic name="Special" typeId="9fb9-b2be-dfa5-713d">-</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="The Silent Death" id="e9d9-d8ff-4902-54a4" hidden="false">
              <description>May strike several targets; nominate your first target and roll to hit. If successful, nominate another target within 2&quot;. Continue nominating targets and rolling to hit until you miss or until there are no further targets within the weapon‘s range and/or within 2&quot; of the last target.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="The Blade of Destruction" id="7177-65eb-e477-efac" collective="false" hidden="false" import="true" type="upgrade">
