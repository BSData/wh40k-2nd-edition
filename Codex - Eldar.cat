    <selectionEntry name="Wraithguard" id="d95d-b7d3-b09c-e104" collective="false" hidden="false" import="true" type="upgrade">
      <categoryLinks>
        <categoryLink name="Squads" id="a15f-7719-839a-6669" hidden="false" primary="true" targetId="2b85-5dce-be87-156f"/>
        <categoryLink name="Eldar" id="e09e-4293-19a7-9c92" hidden="false" primary="false" targetId="261d-dcfd-16cf-3caf"/>
      </categoryLinks>
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
      <rules>
        <rule name="Wraithguard Armour" id="b12c-445e-fa52-73e9" hidden="false" page="27" publicationId="71ba-82e2-d83c-d33d">
          <description>Wraithguard have an armour value like vehicles instead of a normal Toughness. Their armour is 10 from any facing. If their armour is penetrated:
1-2: Model is knocked to ground. May not move in following movement phase while it stands back up
3-4: Takes 1 wound. Model is destroyed after taking 2 wounds
5-6: Model is destroyed. Roll a D6 for any model with 2&quot; of the Wraithguard. On a 6 the model is consumed by the warp and destroyed. Only a living creature or a spirit powered Wraithguard or Dreadnought can be affected in this way.</description>
        </rule>
        <rule name="Proximity to Eldar" id="75ee-9172-392e-01e6" hidden="false" page="27" publicationId="71ba-82e2-d83c-d33d">
          <description>If there is a Farseer or Warlock within 12&quot; a Wraithguard may add +1 to any shooting roll. If there are no living Eldar on the battlefield, Wraithguard must immediately retreat to their table edge and may do nothing else. Note that dreadnoughts nor the Avatar count as living Eldar</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Wraithguard" id="7c3a-7598-e7a0-7c6d" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="b1c5-e551-0c15-2873" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="5"/>
