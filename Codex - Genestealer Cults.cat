  <sharedRules>
    <rule name="Leadership" id="80ff-74b3-d4b7-9eeb" hidden="false" page="74" publicationId="4740-6730-10c0-9b25">
      <description>If this model is the army commander then any Cult broods that have a model within 12&quot; of him may use his Leadership value when they take a Leadership test.</description>
    </rule>
    <rule name="Immune to Psychology" id="6f65-d3c3-ced8-f603" hidden="false" publicationId="4740-6730-10c0-9b25">
      <description>Immune to all psychology. Cannot be affected by fear, terror, or any of the psychological factors in the Warhammer rulebook. 
Still affected by Break tests like other troops</description>
    </rule>
    <rule name="Icon Bearer" id="5862-aa0d-2da2-4df1" hidden="false" page="75" publicationId="4740-6730-10c0-9b25">
      <description>Any Cult broods that have a model within 12&quot; of the Icon Bearer may re-roll the dice if they fail a Break test</description>
    </rule>
    <rule name="Mortar" id="3900-4a54-e3fa-7193" hidden="false" page="22" publicationId="a1e3-886b-e509-d15a">
      <description>See Imperial Guard Codex pg. 22 for rules on firing the mortar</description>
    </rule>
    <rule name="Imperial Chimera Damage Table" id="d901-96c6-0d7c-bf12" hidden="false" page="datafax" publicationId="a1e3-886b-e509-d15a">
      <description>1-2 Track - Hit closest to shooter
3-5: Hull
6: Turret
See datafax for damage table results</description>
    </rule>
    <rule name="Imperial Guard Sentinel Damage Table" id="bbd3-3894-a9d1-c08d" hidden="false" page="datafax" publicationId="a1e3-886b-e509-d15a">
      <description>1-2: Legs
3: Assault Cannon
4-5: Body
6: Brood Brother
See datafax for damage table results</description>
    </rule>
    <rule name="Leman Russ Battle Tank Damage Table" id="4aa7-8c2b-e551-e5ba" hidden="false" page="datafax" publicationId="a1e3-886b-e509-d15a">
      <description>1: Track
2-3: Hull
4: Heavy Bolter
5-6: Turret
See datafax for damage table results</description>
    </rule>
    <rule name="Imperial Guard Land Speeder Damage Table" id="f787-4c7f-8a7b-d261" hidden="false" publicationId="a1e3-886b-e509-d15a">
      <description>1-2: Crew*
3-6: Land Speeder
*Hit closest to attacker
See datafax for damage table results</description>
    </rule>
    <rule name="Land Raider Damage Table" id="f05d-f96f-833c-2bb8" hidden="false" page="Datafax">
      <description>1-2: Track - Hit closest to shooter
3-5: Hull
6: Lascannon - Hit closest to shooter
See datafax for damage table</description>
    </rule>
    <rule name="Rhino Damage Table" id="a92d-cf62-27af-3b0c" hidden="false" page="Datafax">
      <description>1: Track - Closest track to shooter
2-5: Hull
6: Weapons
See datafax for damage table</description>
    </rule>
    <rule name="Predator Damage Table" id="9956-00d5-940f-cd28" hidden="false">
      <description>1: Track - Closest track to shooter
2-3: Hull
4: Sponson - Closest track to shooter
5-6: Turret
See datafax for damage table</description>
    </rule>
    <rule name="Teeth &amp; Claws" id="7d90-63d0-e629-c302" hidden="false">
      <description>Consult the Strength to Save Modifier table:


Strength 3 or less: 0
Strength 4: -1
Strength 5: -2
Strength 6: -3
Strength 7: -4
Strength 8: -5
Strength 9 or More: -6</description>
    </rule>
  </sharedRules>
