  <forceEntries>
    <forceEntry name="Imperial Agents Allies - 25% support armies (Sisters &amp; Guard)" id="76b3-3823-3b02-d661" hidden="false">
      <categoryLinks>
        <categoryLink name="Imperial Agents" id="96a9-95d5-a417-31d7" hidden="false" targetId="7b75-aa9e-1b94-f4a5">
          <constraints>
            <constraint id="db54-e8ae-9a6b-b598" field="points" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="max" value="0"/>
            <constraint id="1d41-24ec-d694-193b" field="points" includeChildForces="true" includeChildSelections="true" percentValue="true" scope="roster" shared="true" type="max" value="25"/>
          </constraints>
          <modifierGroups>
            <modifierGroup type="and">
              <comment>When you have no points limit</comment>
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition childId="any" field="limit::points" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="lessThan" value="1"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
              <modifiers>
                <modifier field="db54-e8ae-9a6b-b598" type="set" value="-1"/>
              </modifiers>
            </modifierGroup>
            <modifierGroup type="and">
              <comment>When having a points limit</comment>
              <modifiers>
                <modifier field="db54-e8ae-9a6b-b598" type="increment" value="1">
                  <conditionGroups>
                    <conditionGroup type="and">
                      <conditions>
                        <condition childId="any" field="limit::points" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="atLeast" value="1"/>
                      </conditions>
                    </conditionGroup>
                  </conditionGroups>
                  <repeats>
                    <repeat childId="any" field="limit::points" includeChildForces="true" includeChildSelections="true" repeats="0.5" roundUp="false" scope="roster" shared="true" value="1"/>
                  </repeats>
                </modifier>
                <modifier field="1d41-24ec-d694-193b" type="set" value="-1">
                  <conditionGroups>
                    <conditionGroup type="and">
                      <conditions>
                        <condition childId="any" field="limit::points" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="atLeast" value="1"/>
                      </conditions>
                    </conditionGroup>
                  </conditionGroups>
                </modifier>
              </modifiers>
            </modifierGroup>
          </modifierGroups>
        </categoryLink>
      </categoryLinks>
    </forceEntry>
