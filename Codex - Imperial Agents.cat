                        <condition childId="c9ac-d1ea-8baa-ee5d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="notEqualTo" value="1"/>
                      </conditions>
                    </conditionGroup>
