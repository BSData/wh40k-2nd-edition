            <characteristic name="Special" typeId="9fb9-b2be-dfa5-713d">Executioner Rounds</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Executioner Rounds" id="c745-12e2-8fc5-5d0a" hidden="false">
          <description>Because it locks onto a target’s energy signature the Executioner shell may even be fired at hidden targets providing they have already been detected.</description>
        </rule>
        <rule name="Knockback" id="6612-5484-6d42-6b22" hidden="false" page="31" publicationId="06e5-8e36-e8c8-aec3">
          <description>If  a  target  is  hit   by  a  shotgun  but  not  slain,  then  it  is automatically  knocked back 2&quot; and will fall  over on a  D6  roll of  4+.  A  knocked  over  model must spend  its  next movement phase standing up. Note that  this  rule  only  affects  ordinary troopers - not vehicles, robots, Terminators or dreadnoughts.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry name="Nemesis Force Weapon" id="20be-6362-8ed4-9396" hidden="false" import="true" type="upgrade">
      <entryLinks>
        <entryLink name="Storm Bolter" id="e91b-5315-a04d-9bb3" hidden="false" import="true" targetId="8b0c-9093-dc69-c9e8" type="selectionEntry">
