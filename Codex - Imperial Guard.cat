                <infoLink name="Close Combat" id="971d-9f98-cfa7-70a9" hidden="false" targetId="c494-c170-605c-8959" type="rule"/>
              </infoLinks>
              <profiles>
                <profile name="C&apos;tan Phase Knife" id="f543-522c-c11d-f2a5" hidden="false" typeId="d8e8-6c66-f558-30ee" typeName="Weapon">
                  <characteristics>
