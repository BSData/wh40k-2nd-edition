        </entryLink>
        <entryLink name="Veteran Abilities" id="026f-148d-0034-4b9b" collective="false" hidden="false" import="true" sortIndex="6" targetId="d15e-9b29-96bc-9bce" type="selectionEntryGroup">
          <constraints>
