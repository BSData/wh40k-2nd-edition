    <profile name="Comm-link" id="54a9-406d-27b5-9ea1" hidden="false" page="71" publicationId="a1e3-886b-e509-d15a" typeId="cc8b-49d5-829c-bfaf" typeName="Wargear">
      <characteristics>
        <characteristic name="Special" typeId="f917-8cd8-7592-47dd">If a Command squad or Command HQ includes a Guardsman with a comm-link then the squad&apos;s commanding officer may call down a barrage during the game. The Commanding Officer can only do this if they and the model with the comm-link are still alive.</characteristic>
      </characteristics>
    </profile>
