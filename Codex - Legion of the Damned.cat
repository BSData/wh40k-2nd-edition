        <profile name="Low energy" id="e92a-dc91-c8ec-0bc9" hidden="false" page="37" publicationId="06e5-8e36-e8c8-aec3" typeId="d8e8-6c66-f558-30ee" typeName="Weapon">
          <characteristics>
            <characteristic name="Short range" typeId="a108-ac67-8c42-6bbb">20</characteristic>
            <characteristic name="Long Range" typeId="3acf-5fa0-de29-6094">40</characteristic>
