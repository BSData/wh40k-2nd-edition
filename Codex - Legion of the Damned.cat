      <rules>
        <rule name="Plasma Pistol - CC Overheat" id="c60a-e502-6e54-d996" hidden="false">
          <description>If used in close combat, any Attack dice that rolls a fumble has the same effect as rolling a jam on the Sustained Fire dice when you are shooting (see Plasma Overheat).</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry name="Mk 1 Heavy Plasma Gun" id="83cc-c03b-d952-4234" collective="false" hidden="false" import="true" page="37" publicationId="06e5-8e36-e8c8-aec3" type="upgrade">
