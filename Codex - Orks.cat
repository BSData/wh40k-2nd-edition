          <costs>
            <cost name="pts" typeId="points" value="5"/>
          </costs>
          <profiles>
            <profile name="Spike Arm" id="926e-b917-5616-e3ca" hidden="false" typeId="cc8b-49d5-829c-bfaf" typeName="Wargear">
              <characteristics>
                <characteristic name="Special" typeId="f917-8cd8-7592-47dd">+1 WS in close combat and always counts as having higher Initative in the case of the Combat Scores being drawn</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Gyro-Stabilised Monowheel" id="1cd1-d285-b969-fa15" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="c33e-5371-886e-26f6" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
            <constraint id="2d65-37ae-bd1c-8666" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
