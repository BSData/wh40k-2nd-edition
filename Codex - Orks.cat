      <selectionEntryGroups>
        <selectionEntryGroup name="Wargear Cards (Vehicle - Orks)" id="ac84-4872-b031-eb51" collective="false" hidden="false" import="true">
          <selectionEntries>
            <selectionEntry name="Moto-X" id="6e8f-5cb8-93db-a577" collective="false" hidden="false" import="true" type="upgrade">
              <costs>
                <cost name="pts" typeId="points" value="10"/>
              </costs>
              <profiles>
                <profile name="Moto-X" id="6cab-da21-a682-08a4" hidden="false" typeId="cc8b-49d5-829c-bfaf" typeName="Wargear">
                  <characteristics>
                    <characteristic name="Special" typeId="f917-8cd8-7592-47dd">The Warbike can travel up to combat speed across difficult ground. In addition, the Warbike may attempt to cross linear obstacles that are no taller than the front wheel. Roll a D6, on a 4+ the obstacle is succesfully crossed, other the Warbike collides as normal</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Skrabbla" id="81e6-1bac-99e6-c4a6" collective="false" hidden="false" import="true" type="upgrade">
              <costs>
                <cost name="pts" typeId="points" value="10"/>
              </costs>
              <profiles>
                <profile name="Skrabbla" id="a013-54b8-dddf-fc61" hidden="false" typeId="cc8b-49d5-829c-bfaf" typeName="Wargear">
                  <characteristics>
                    <characteristic name="Special" typeId="f917-8cd8-7592-47dd">A Warbike rider with a skrabbla may add +2 to his dice rolls on the skid turn chart</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="&apos;Oooge Xhausts" id="a180-0dc2-ad28-74a9" collective="false" hidden="false" import="true" type="upgrade">
              <costs>
                <cost name="pts" typeId="points" value="5"/>
              </costs>
              <profiles>
                <profile name="&apos;Oooge Xhausts" id="a634-977d-e680-1e52" hidden="false" typeId="cc8b-49d5-829c-bfaf" typeName="Wargear">
                  <characteristics>
                    <characteristic name="Special" typeId="f917-8cd8-7592-47dd">Any enemy units on Overwatch that are within 12&quot; of the Warbike must pass a Leadership test or lose Overwatch, just as if they had been shot at</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Squigg Fuel Injector" id="6d7c-af62-6cfb-4d57" collective="false" hidden="false" import="true" type="upgrade">
              <costs>
                <cost name="pts" typeId="points" value="10"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="true">
                  <conditionGroups>
                    <conditionGroup type="and">
                      <conditions>
                        <condition childId="e0a6-b80b-81e8-bd34" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="instanceOf" value="0"/>
                      </conditions>
                    </conditionGroup>
                  </conditionGroups>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Squigg Fuel Injector" id="0540-dec0-9804-49d4" hidden="false" typeId="cc8b-49d5-829c-bfaf" typeName="Wargear">
                  <characteristics>
                    <characteristic name="Special" typeId="f917-8cd8-7592-47dd">May be used at the end of the vehicle&apos;s movement phase, and makes it move forward another 3D6&quot; in a straight line immediately. If the roll for the distance is 15 or more the vehicle starts to rattle apart - move the vehicle, then roll a D6 on the hull damage table</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Kustom Force Field" id="87b6-4f87-0616-be01" collective="false" hidden="false" import="true" type="upgrade">
              <costs>
                <cost name="pts" typeId="points" value="20"/>
              </costs>
              <profiles>
                <profile name="Kustom Force Field" id="5998-f06c-2efc-af26" hidden="false" typeId="cc8b-49d5-829c-bfaf" typeName="Wargear">
                  <characteristics>
                    <characteristic name="Special" typeId="f917-8cd8-7592-47dd">Whenever the vehicle is hit, roll a D6 and deduct the result from the Strength of the incoming shot. On a result of a 6, the hit is stopped completely but the Force Field is burned out and destroyed, inflicting a S4 hit on a randomly-selected crewman</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
