          <characteristics>
            <characteristic name="Slow Speed" typeId="7c52-da5f-7f1a-95fd">*</characteristic>
            <characteristic name="Combat Speed" typeId="87a6-dd16-ba8f-ff71">*</characteristic>
            <characteristic name="Fast Speed" typeId="92f6-98b4-3770-d8d9">*</characteristic>
            <characteristic name="Type" typeId="8567-afc3-f137-4d64">Transport</characteristic>
