            <profile name="Sniffer Squig" id="3798-7e36-f2fa-f4ff" hidden="false" typeId="cc8b-49d5-829c-bfaf" typeName="Wargear">
              <characteristics>
                <characteristic name="Special" typeId="f917-8cd8-7592-47dd">Any troops in the opposing army that are allowed to set up using the Infiltration rules may not set up within 24&quot; of any Sniffer squigs. 
In addition an Imperial Assassin with Cameleoline may not reveal himself to be a disguised Ork model within 18&quot; of any Sniffer Squigs</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Doc&apos;s Tools" id="f92e-7b5d-df61-15d5" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="b7ef-e7a8-1b05-f238" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="8"/>
          </costs>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="04d9-1039-d3c3-999c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="notInstanceOf" value="0"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Doc&apos;s Tools" id="04c5-cb2a-7ef4-55db" hidden="false" typeId="cc8b-49d5-829c-bfaf" typeName="Wargear">
              <characteristics>
                <characteristic name="Special" typeId="f917-8cd8-7592-47dd">A Painboy with a set of tools always counts as having two close combat weapons, and so always rolls an extra dice in close combat. If the Painboy wins a round of combat and inflicts at least 1 wound then the opponent is assumed to have been injected with a Syringe squig. The model is removed as a casualty even if they still have wounds remaining.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Kustom Blasta" id="1939-3b47-870a-e9b9" collective="false" hidden="false" import="true" page="48" publicationId="9f92-b7df-cf75-9a46" type="upgrade">
          <constraints>
            <constraint id="77aa-6e9c-a164-8fd1" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
          </costs>
          <profiles>
            <profile name="Kustom Blasta" id="ec3b-75ab-81dc-88d8" hidden="false" typeId="d8e8-6c66-f558-30ee" typeName="Weapon">
              <characteristics>
                <characteristic name="Short range" typeId="a108-ac67-8c42-6bbb">16</characteristic>
                <characteristic name="Long Range" typeId="3acf-5fa0-de29-6094">36</characteristic>
                <characteristic name="Short &apos;To Hit’" typeId="bbc0-6de5-4dfa-9328">-</characteristic>
                <characteristic name="Long &apos;To Hit’" typeId="10bb-0500-b03c-643c">-1</characteristic>
                <characteristic name="Strength" typeId="e297-34fa-4b72-f0b6">Art. Dice</characteristic>
                <characteristic name="Damage" typeId="8978-f9c3-8957-1481">1</characteristic>
                <characteristic name="Save Modifier" typeId="53ec-cd58-3d6e-c00d">-1</characteristic>
                <characteristic name="Armour Penetration" typeId="0530-f4b7-b7db-de67">Various</characteristic>
                <characteristic name="Special" typeId="9fb9-b2be-dfa5-713d">D3&quot; Blast</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Kustom Blasta" id="5527-caba-bd7f-006a" hidden="false" page="45" publicationId="9f92-b7df-cf75-9a46">
              <description>Roll a D3 to determine blast size each time the weapon fires

Roll an artillery dice to determine the Strength everytime the weapon fires. If a misfire is rolled the weapon explodes and the user carrying it takes a S4 hit</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Mekboy&apos;s Tools" id="fc35-06bf-78a8-5790" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="0d64-c953-ea00-d066" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="5"/>
          </costs>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="4239-fecc-9d06-d706" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="notInstanceOf" value="0"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Mekboy&apos;s Tools" id="848b-b8a0-db86-2663" hidden="false" typeId="cc8b-49d5-829c-bfaf" typeName="Wargear">
              <characteristics>
                <characteristic name="Special" typeId="f917-8cd8-7592-47dd">A Mekboy with a set of tools always counts as having two close combat weapons, and so always rolls an extra dice in close combat.
In addition if the Mekboy starts a turn on, in, or next to a damaged vehicle he may attempt to repair one damaged location. The location must be repairable (ie Weapon blown off, engine exploded cannot be fixed). 
Location fixed on a 4+</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Kustom Force Field" id="3cf2-18db-43ea-0eb7" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="a3b4-6a62-96c9-2d13" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
            <constraint id="868c-ee69-d2f4-4e54" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="20"/>
          </costs>
          <profiles>
            <profile name="Kustom Force Field" id="5850-54a1-5494-7e57" hidden="false" typeId="cc8b-49d5-829c-bfaf" typeName="Wargear">
              <characteristics>
                <characteristic name="Special" typeId="f917-8cd8-7592-47dd">Whenever the wearer is hit roll a D6 decuct from the Strength of the incoming hit. On a roll of a 6 the hit is automatically stopped but the Ork suffers a S3 hit instead as the field shorts out. If the field shorts out this card is discarded immediately.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Force Field Projekta" id="4e6f-f317-d6b2-957b" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="fcf1-14bc-84cb-6410" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
            <constraint id="9e98-8363-ab75-4554" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="50"/>
          </costs>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="4239-fecc-9d06-d706" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="notInstanceOf" value="0"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Force Field Projekta" id="a930-937d-2be3-8e78" hidden="false" typeId="cc8b-49d5-829c-bfaf" typeName="Wargear">
              <characteristics>
                <characteristic name="Special" typeId="f917-8cd8-7592-47dd">The force field may be turned on at the start of any Ork turn. It is represented by a 12&quot; ruler, or by two dice or counters placed 12&quot; apart, and must be placed completely within 18&quot; of the operator. Once in place nothing can shoot or move through the force field under any circumstances. This includes teleporting models, psychic attacks, skimmers, and mole mortar attacks. Note that the force field stops all Ork attacks and movement as well. Vehicles that hit the force field must stop moving but do not suffer any damage. Roll a D6 for the force field at the start of each susequent Ork turn. On a roll of 1-3 it burns out and may not be used again for the rest of the battle. On a 4+ it keeps working and can be left in place or turned off, or replaced anywhere within 18&quot; of the operator.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Squig Attack Arm" id="2069-23bd-662c-bf9e" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="644b-8068-312a-a427" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="eb5c-d2ff-e1a3-0e6f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="3"/>
          </costs>
          <profiles>
            <profile name="Squig Attack Arm" id="10f2-2524-b09d-e537" hidden="false" typeId="cc8b-49d5-829c-bfaf" typeName="Wargear">
              <characteristics>
                <characteristic name="Special" typeId="f917-8cd8-7592-47dd">In close combat the Ork automatically unleashes the Squig as its opponent closes in so resolve the attack during the close combat phase before any attack dice are rolled. The Ork&apos;s opponent suffers an automatic Strength 5 hit with no saving throw modifer. 
One Use Only</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Spike Arm" id="7116-b892-f72b-98f6" collective="false" hidden="false" import="true" publicationId="9f92-b7df-cf75-9a46" type="upgrade">
          <constraints>
            <constraint id="8cc0-a732-a1f1-d03c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="f95a-9c8a-b435-a5d3" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
