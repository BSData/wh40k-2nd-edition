          <profiles>
            <profile name="Weirdboy Staff" id="eec5-1ac6-2cdf-237d" hidden="false" typeId="cc8b-49d5-829c-bfaf" typeName="Wargear">
              <characteristics>
                <characteristic name="Special" typeId="f917-8cd8-7592-47dd">A Weirdboy staff is a force weapon so the Weirdboy can add his mastery level to his Strength. Wounds daemons automatically in close combat. The Weirdboy can reroll the dice for his Waaagh! test if he fails the first roll</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Steel Skull" id="f2f6-9930-ee08-d4de" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="1faa-5d12-9d34-9fa6" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="5"/>
          </costs>
          <infoLinks>
            <infoLink name="Mad!" id="467f-7b34-24cd-2234" hidden="false" targetId="fa1a-f039-985a-0269" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Steel Skull" id="8cb4-9856-f482-162b" hidden="false" typeId="cc8b-49d5-829c-bfaf" typeName="Wargear">
              <characteristics>
                <characteristic name="Special" typeId="f917-8cd8-7592-47dd">Gains +1 Toughness. 
Becomes subject to the rules for Madboyz</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Runtherd&apos;s Grabba-stick" id="49ea-b5a9-056c-8204" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="644b-5c01-35c5-35e5" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
