            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="e3c7-9896-d918-9c99" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="notInstanceOf" value="0"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Runtherd&apos;s Grabba-stick" id="101c-09d7-0221-f120" hidden="false" typeId="cc8b-49d5-829c-bfaf" typeName="Wargear">
              <characteristics>
                <characteristic name="Special" typeId="f917-8cd8-7592-47dd">can be used at the start of any close combat phase to attack 1 enemy model in base to base contact. This is made before normal close combat attacks are resolved and hits on a 4+. If it hits, it does a S8 hit with no saving throw allowed. If they survive the hit their Weapon Skill is reduced to 0 in the ensuing round of combat</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Teleskopik Legz" id="23b7-d09c-5ffe-48bf" collective="false" hidden="false" import="true" publicationId="9f92-b7df-cf75-9a46" type="upgrade">
          <constraints>
            <constraint id="d2ed-3eb7-67d7-2f6c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="f6ad-bd21-ab4f-6255" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="5"/>
          </costs>
          <profiles>
            <profile name="Teleskopik Legz" id="8345-a4c0-b33f-68d0" hidden="false" typeId="cc8b-49d5-829c-bfaf" typeName="Wargear">
              <characteristics>
                <characteristic name="Special" typeId="f917-8cd8-7592-47dd">Gain +2 to Move characteristic and do not suffer any movement penalties for crossing obstacles up to 2&quot; high. Ork can raise itself up by 2&quot; in the shooting phase allowing it to see and shoot over intervening terrain.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
