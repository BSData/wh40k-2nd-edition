                      <characteristics>
                        <characteristic name="Special" typeId="f917-8cd8-7592-47dd">Any enemy units on Overwatch that are within 12&quot; of the Warbike must pass a Leadership test or lose Overwatch, just as if they had been shot at</characteristic>
                      </characteristics>
                    </profile>
