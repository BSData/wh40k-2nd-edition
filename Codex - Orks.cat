                  <profiles>
                    <profile name="Moto-X" id="e29f-4980-f0ad-5e50" hidden="false" typeId="cc8b-49d5-829c-bfaf" typeName="Wargear">
                      <characteristics>
                        <characteristic name="Special" typeId="f917-8cd8-7592-47dd">The Warbike can travel up to combat speed across difficult ground. In addition, the Warbike may attempt to cross linear obstacles that are no taller than the front wheel. Roll a D6, on a 4+ the obstacle is succesfully crossed, other the Warbike collides as normal</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
