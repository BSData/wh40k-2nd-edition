  <forceEntries>
    <forceEntry name="Orks" id="d235-52bd-79b4-0b6e" hidden="false">
      <categoryLinks>
        <categoryLink name="Characters" id="9a48-2df3-23d3-f43d" hidden="false" primary="false" targetId="23ab-e52d-6e65-01d5">
          <constraints>
            <constraint id="7691-f1ba-1ff2-4760" field="points" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="max" value="0"/>
            <constraint id="13d9-1b24-642b-8657" field="points" includeChildForces="true" includeChildSelections="true" percentValue="true" scope="roster" shared="true" type="max" value="50"/>
          </constraints>
          <modifierGroups>
            <modifierGroup type="and">
              <comment>When you have no points limit</comment>
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition childId="any" field="limit::points" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="lessThan" value="1"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
              <modifiers>
                <modifier field="7691-f1ba-1ff2-4760" type="set" value="-1"/>
              </modifiers>
            </modifierGroup>
            <modifierGroup type="and">
              <comment>When having a points limit</comment>
              <modifiers>
                <modifier field="7691-f1ba-1ff2-4760" type="increment" value="1">
                  <conditionGroups>
                    <conditionGroup type="and">
                      <conditions>
                        <condition childId="any" field="limit::points" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="atLeast" value="1"/>
                      </conditions>
                    </conditionGroup>
                  </conditionGroups>
                  <repeats>
                    <repeat childId="any" field="limit::points" includeChildForces="true" includeChildSelections="true" repeats="0.5" roundUp="false" scope="roster" shared="true" value="1"/>
                  </repeats>
                </modifier>
                <modifier field="13d9-1b24-642b-8657" type="set" value="-1">
                  <conditionGroups>
                    <conditionGroup type="and">
                      <conditions>
                        <condition childId="any" field="limit::points" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="atLeast" value="1"/>
                      </conditions>
                    </conditionGroup>
                  </conditionGroups>
                </modifier>
              </modifiers>
            </modifierGroup>
          </modifierGroups>
        </categoryLink>
        <categoryLink name="Mobs" id="f0f5-1189-2379-f439" hidden="false" primary="false" targetId="f72b-82f4-2a38-7d26">
          <constraints>
            <constraint id="ef97-7067-9099-6dea" field="points" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="min" value="0"/>
            <constraint id="953e-73b4-c1df-3433" field="points" includeChildForces="true" includeChildSelections="true" percentValue="true" scope="roster" shared="true" type="min" value="25"/>
          </constraints>
          <modifierGroups>
            <modifierGroup type="and">
