          </costs>
          <infoLinks>
            <infoLink name="Sustained Fire" id="efac-fa40-fe95-5fb9" hidden="false" targetId="0b67-c911-308c-4960" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Kustom Shoota" id="a7fe-bb65-4513-1b68" hidden="false" typeId="d8e8-6c66-f558-30ee" typeName="Weapon">
              <characteristics>
                <characteristic name="Short range" typeId="a108-ac67-8c42-6bbb">12</characteristic>
                <characteristic name="Long Range" typeId="3acf-5fa0-de29-6094">32</characteristic>
                <characteristic name="Short &apos;To Hit’" typeId="bbc0-6de5-4dfa-9328">+1</characteristic>
                <characteristic name="Long &apos;To Hit’" typeId="10bb-0500-b03c-643c">-1</characteristic>
                <characteristic name="Strength" typeId="e297-34fa-4b72-f0b6">Art. Dice</characteristic>
                <characteristic name="Damage" typeId="8978-f9c3-8957-1481">1</characteristic>
                <characteristic name="Save Modifier" typeId="53ec-cd58-3d6e-c00d">-2</characteristic>
                <characteristic name="Armour Penetration" typeId="0530-f4b7-b7db-de67">Various</characteristic>
                <characteristic name="Special" typeId="9fb9-b2be-dfa5-713d">Sustained Fire - 2 dice</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Kustom Shoota" id="1f73-dedc-1111-80a8" hidden="false" page="45" publicationId="9f92-b7df-cf75-9a46">
              <description>Roll an artillery dice to determine the Strength everytime the weapon fires. If a misfire is rolled the weapon explodes and the user carrying it takes a S4 hit</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Cybork Body" id="a509-4eb5-722a-7df4" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="3058-e5cc-0644-9f11" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
            <constraint id="505f-1717-25ae-3577" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="35"/>
          </costs>
          <profiles>
            <profile name="Cybork Body" id="fd5b-b031-e429-5c92" hidden="false" page="46" publicationId="9f92-b7df-cf75-9a46" typeId="cc8b-49d5-829c-bfaf" typeName="Wargear">
              <characteristics>
                <characteristic name="Special" typeId="f917-8cd8-7592-47dd">Increase Strength and Wounds by +2
In addition, if the Ork is hit by an attack then he is treated in the same way as a vehicle or Dreadnought with an armour value of 15. Roll for armour penetration as normal. If the attack equals the armour value, then the Ork is knocked over and may not move or shoot in his next turn while he stands up. If the attack beats the Ork&apos;s armour value, then he knocked over as above and suffers 1 wound for each point the attack beat the armour value by.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Buzzer Squig Stikkbombz" id="e7b4-f34d-9b7c-b32a" collective="false" hidden="false" import="true" page="46" publicationId="9f92-b7df-cf75-9a46" type="upgrade">
          <constraints>
            <constraint id="1702-50ef-26c7-c601" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="c65e-35b8-fb7c-8795" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="5"/>
          </costs>
          <profiles>
            <profile name="Buzzer Squig Stikkbombz" id="a5bc-6aea-e542-0cd9" hidden="false" typeId="cc8b-49d5-829c-bfaf" typeName="Wargear">
              <characteristics>
                <characteristic name="Special" typeId="f917-8cd8-7592-47dd">Thrown like a grenade. Place a Buzzer Squig template where the stikkbomb lands. Work out the effect of the Buzzer squigs as if a Squig katapult attack had landed at the same spot (Pg. 15).

One Use Only</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Vaxxine Squig" id="9e6e-85fe-ddba-0002" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
