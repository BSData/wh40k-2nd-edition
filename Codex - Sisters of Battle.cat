    <profile name="Bodyguard" id="3265-1a7d-af78-73f3" hidden="false" page="53" publicationId="cad3-a694-b720-6309" typeId="219f-0faa-a2d8-f766" typeName="Unit">
      <characteristics>
        <characteristic name="Unit Type" typeId="49de-956f-8797-7436">Bodyguard</characteristic>
