  <sharedProfiles>
    <profile name="Flail" id="9a93-b9fb-5d86-05e5" hidden="false" page="52" publicationId="cad3-a694-b720-6309" typeId="cc8b-49d5-829c-bfaf" typeName="Wargear">
      <characteristics>
        <characteristic name="Special" typeId="f917-8cd8-7592-47dd">+2 to users Strength in first round of combat, but cannot be used afterwards. A flail cannot be parried</characteristic>
      </characteristics>
    </profile>
    <profile name="Two-handed Weapon" id="a672-d8fd-d9a8-3ed8" hidden="false" page="52" publicationId="cad3-a694-b720-6309" typeId="cc8b-49d5-829c-bfaf" typeName="Wargear">
      <characteristics>
        <characteristic name="Special" typeId="f917-8cd8-7592-47dd">Add +2 to the users Strength but if the combat is a draw, the wielder loses regardless of the relative Initiative values of the combatants</characteristic>
      </characteristics>
    </profile>
    <profile name="Lances" id="5ce1-437f-c72b-0bc2" hidden="false" page="52" publicationId="cad3-a694-b720-6309" typeId="cc8b-49d5-829c-bfaf" typeName="Wargear">
      <characteristics>
        <characteristic name="Special" typeId="f917-8cd8-7592-47dd">+2 to users Strength when charging. Can only be used by mounted models</characteristic>
      </characteristics>
    </profile>
