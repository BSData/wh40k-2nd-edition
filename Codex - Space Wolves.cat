  <forceEntries>
    <forceEntry name="Space Wolves" id="6424-93f5-0595-ee8b" hidden="false">
      <categoryLinks>
        <categoryLink name="Squads" id="a0d7-961d-9fcc-e3f3" hidden="false" primary="false" targetId="b960-4b95-7dcc-14c5">
          <constraints>
            <constraint id="b7eb-ff7a-087c-cdf8" field="points" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="min" value="0"/>
            <constraint id="b0cc-ac68-0b3d-f588" field="points" includeChildForces="true" includeChildSelections="true" percentValue="true" scope="roster" shared="true" type="min" value="25"/>
          </constraints>
          <modifierGroups>
            <modifierGroup type="and">
              <comment>When you have no points limit</comment>
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition childId="any" field="limit::points" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="lessThan" value="1"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
              <modifiers>
                <modifier field="b7eb-ff7a-087c-cdf8" type="set" value="-1"/>
              </modifiers>
            </modifierGroup>
            <modifierGroup type="and">
              <comment>When having a points limit</comment>
              <modifiers>
                <modifier field="b7eb-ff7a-087c-cdf8" type="increment" value="1">
                  <conditionGroups>
                    <conditionGroup type="and">
                      <conditions>
                        <condition childId="any" field="limit::points" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="atLeast" value="1"/>
                      </conditions>
                    </conditionGroup>
                  </conditionGroups>
                  <repeats>
                    <repeat childId="any" field="limit::points" includeChildForces="true" includeChildSelections="true" repeats="0.25" roundUp="false" scope="roster" shared="true" value="1"/>
                  </repeats>
                </modifier>
                <modifier field="b0cc-ac68-0b3d-f588" type="set" value="-1">
                  <conditionGroups>
                    <conditionGroup type="and">
                      <conditions>
                        <condition childId="any" field="limit::points" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="atLeast" value="1"/>
                      </conditions>
                    </conditionGroup>
                  </conditionGroups>
                </modifier>
              </modifiers>
            </modifierGroup>
          </modifierGroups>
        </categoryLink>
        <categoryLink name="Characters" id="3a2a-8961-4602-a2bc" hidden="false" primary="false" targetId="2cae-0005-ed61-2fd2">
          <constraints>
            <constraint id="3be9-20c9-d942-2b89" field="points" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="max" value="0"/>
            <constraint id="1e5c-50a2-9a5c-4ab9" field="points" includeChildForces="true" includeChildSelections="true" percentValue="true" scope="roster" shared="true" type="max" value="50"/>
          </constraints>
          <modifierGroups>
            <modifierGroup type="and">
              <comment>When you have no points limit</comment>
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition childId="any" field="limit::points" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="lessThan" value="1"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
              <modifiers>
                <modifier field="3be9-20c9-d942-2b89" type="set" value="-1"/>
              </modifiers>
            </modifierGroup>
            <modifierGroup type="and">
              <comment>When having a points limit</comment>
              <modifiers>
                <modifier field="3be9-20c9-d942-2b89" type="increment" value="1">
                  <conditionGroups>
                    <conditionGroup type="and">
                      <conditions>
                        <condition childId="any" field="limit::points" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="atLeast" value="1"/>
                      </conditions>
                    </conditionGroup>
                  </conditionGroups>
                  <repeats>
                    <repeat childId="any" field="limit::points" includeChildForces="true" includeChildSelections="true" repeats="0.5" roundUp="false" scope="roster" shared="true" value="1"/>
                  </repeats>
                </modifier>
                <modifier field="1e5c-50a2-9a5c-4ab9" type="set" value="-1">
                  <conditionGroups>
                    <conditionGroup type="and">
                      <conditions>
                        <condition childId="any" field="limit::points" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="atLeast" value="1"/>
                      </conditions>
                    </conditionGroup>
                  </conditionGroups>
                </modifier>
              </modifiers>
            </modifierGroup>
          </modifierGroups>
        </categoryLink>
        <categoryLink name="Support" id="106b-51cc-eaf4-4aff" hidden="false" targetId="1201-97c2-d0c7-f0c1">
