    <profile name="Bio-Plasma" id="15a6-3e91-dfb9-d24a" hidden="false" typeId="d8e8-6c66-f558-30ee" typeName="Weapon">
      <characteristics>
        <characteristic name="Short range" typeId="a108-ac67-8c42-6bbb">18</characteristic>
        <characteristic name="Long Range" typeId="3acf-5fa0-de29-6094">36</characteristic>
        <characteristic name="Short &apos;To Hit’" typeId="bbc0-6de5-4dfa-9328">+1</characteristic>
        <characteristic name="Long &apos;To Hit’" typeId="10bb-0500-b03c-643c">-</characteristic>
        <characteristic name="Strength" typeId="e297-34fa-4b72-f0b6">8</characteristic>
        <characteristic name="Damage" typeId="8978-f9c3-8957-1481">D6</characteristic>
        <characteristic name="Save Modifier" typeId="53ec-cd58-3d6e-c00d">-4</characteristic>
        <characteristic name="Armour Penetration" typeId="0530-f4b7-b7db-de67">2D6+8</characteristic>
        <characteristic name="Special" typeId="9fb9-b2be-dfa5-713d">Move or Fire, 2&quot; blast radius</characteristic>
      </characteristics>
    </profile>
    <profile name="Acid Blood" id="132f-88ff-538a-df77" hidden="false" page="66" publicationId="4740-6730-10c0-9b25" typeId="584a-05fe-7c57-360c" typeName="Biomorphs">
      <characteristics>
        <characteristic name="Biomorphs" typeId="b4c3-8624-ebe7-241c">If the creature is wounded or killed in close combat all models in base contact with it will suffer an automatic hit with a Strength equal to the creature&apos;s Toughness. The acid causes 1 wound and has a -1 save modifier for each point of Strength over 3 (example S5 = -2 modifier)</characteristic>
      </characteristics>
    </profile>
    <profile name="Bio-Plasma Attack" id="240e-8ca9-114f-3c4f" hidden="false" page="66" publicationId="4740-6730-10c0-9b25" typeId="584a-05fe-7c57-360c" typeName="Biomorphs">
      <characteristics>
        <characteristic name="Biomorphs" typeId="b4c3-8624-ebe7-241c">Move or Fire attack. See Bio-Plasma profile</characteristic>
      </characteristics>
    </profile>
    <profile name="Adrenaline Sac" id="107d-0c15-4c84-066a" hidden="false" page="66" publicationId="4740-6730-10c0-9b25" typeId="584a-05fe-7c57-360c" typeName="Biomorphs">
      <characteristics>
        <characteristic name="Biomorphs" typeId="b4c3-8624-ebe7-241c">Once per game the creature may charge or run and fire in the shooting phase in the same turn even if it using a move or fire weapon or fighting in close combat</characteristic>
      </characteristics>
    </profile>
    <profile name="Aura of Torment" id="e867-5cc5-e640-7611" hidden="false" page="66" publicationId="4740-6730-10c0-9b25" typeId="584a-05fe-7c57-360c" typeName="Biomorphs">
      <characteristics>
        <characteristic name="Biomorphs" typeId="b4c3-8624-ebe7-241c">All non-Tyranids within 8&quot; of the creature suffer a -2 modifier to their Leadership for the purposes of Break, Rally, and Leadership-based psychology tests</characteristic>
      </characteristics>
    </profile>
    <profile name="Enhanced Senses" id="5355-8025-ba2d-37ca" hidden="false" page="66" publicationId="4740-6730-10c0-9b25" typeId="584a-05fe-7c57-360c" typeName="Biomorphs">
      <characteristics>
        <characteristic name="Biomorphs" typeId="b4c3-8624-ebe7-241c">Can locate prey at up to triple its Initiative in inches. Enemy models within this distance are spotted automatically if they are hidden. Cameleoline is ineffective while the model using it is within this distance of the creature, and models may not infilitrate within this distance at the start of the game</characteristic>
      </characteristics>
    </profile>
    <profile name="Flesh Hooks Biomorph" id="451b-3c43-c56f-6291" hidden="false" page="66" publicationId="4740-6730-10c0-9b25" typeId="584a-05fe-7c57-360c" typeName="Biomorphs">
      <characteristics>
        <characteristic name="Biomorphs" typeId="b4c3-8624-ebe7-241c">May fire up to two Flesh Hooks at the same target in the shooting phase. THe creature may not use its flesh hooks and fire another weapon in the same shooting phase.</characteristic>
      </characteristics>
    </profile>
    <profile name="Hardened Carapace" id="11f4-120f-d25e-5069" hidden="false" page="67" publicationId="4740-6730-10c0-9b25" typeId="584a-05fe-7c57-360c" typeName="Biomorphs">
      <characteristics>
        <characteristic name="Biomorphs" typeId="b4c3-8624-ebe7-241c">The creature is granted a 2+ saving throw on D6; note that this armour save is used in lieu of any others it might have had. Note also that Lictors’ saving throws cannot be reduced to less than 5+ by modifiers.</characteristic>
      </characteristics>
    </profile>
    <profile name="Null Zone" id="e90d-359c-bfd3-f0f7" hidden="false" page="67" publicationId="4740-6730-10c0-9b25" typeId="584a-05fe-7c57-360c" typeName="Biomorphs">
      <characteristics>
        <characteristic name="Biomorphs" typeId="b4c3-8624-ebe7-241c">If the creature is affected by a psychic power it can nullify it on a 4+. This nullify can be used against powers targeted directly at the creature and against powers which affect an area or marker including the creature. 
Also gives a 4+ save against Distortion cannons, Wraithcannon, and Vortex Grenades</characteristic>
      </characteristics>
    </profile>
    <profile name="Optic Membranes" id="1a36-cb69-dd91-7fc3" hidden="false" page="67" publicationId="4740-6730-10c0-9b25" typeId="584a-05fe-7c57-360c" typeName="Biomorphs">
      <characteristics>
        <characteristic name="Biomorphs" typeId="b4c3-8624-ebe7-241c">Gives a creature a 2+ save against being blinded by a Photon flare, Conversion field, or similiar device</characteristic>
      </characteristics>
    </profile>
    <profile name="Regenerate" id="1c4d-b414-d0c1-e4e7" hidden="false" page="67" publicationId="4740-6730-10c0-9b25" typeId="584a-05fe-7c57-360c" typeName="Biomorphs">
      <characteristics>
        <characteristic name="Biomorphs" typeId="b4c3-8624-ebe7-241c">If the creature is reduced to 0 Wounds place the model on its side. The creature can still be fired at or hit in close combat. If the creature suffers any more hits while on its side make saving throws as normal and place extra wound markers with the creatures if it suffers them.

In the rally phase in the next Tyranid turn roll to regenerate each Wound marker the creature has suffered. Roll a D6 for each marker: on a 4+ the wound marker is removed. If the number of wound markers the creature has left is equal to or greater than its number of wounds the creature dies. If the creature has fewer wound markers than its number of wounds it stands back up and may act normally in the next turn.</characteristic>
      </characteristics>
    </profile>
    <profile name="Toughened Exoskeleton" id="82e0-1298-c78d-5b5e" hidden="false" page="67" publicationId="4740-6730-10c0-9b25" typeId="584a-05fe-7c57-360c" typeName="Biomorphs">
      <characteristics>
        <characteristic name="Biomorphs" typeId="b4c3-8624-ebe7-241c">This increases the creatrue&apos;s Toughness by +1 up to a maximum of 10</characteristic>
      </characteristics>
    </profile>
    <profile name="Sharpened Claws" id="66c3-9362-0c10-d2b8" hidden="false" page="67" publicationId="4740-6730-10c0-9b25" typeId="584a-05fe-7c57-360c" typeName="Biomorphs">
      <characteristics>
        <characteristic name="Biomorphs" typeId="b4c3-8624-ebe7-241c">The Strength of the creature&apos;s close combat attacks is increased by +2 and it hits in close combat count as psychic attacks for the purposes of penetrating daemonic auras etc.</characteristic>
      </characteristics>
    </profile>
    <profile name="Venom Sacs" id="94ee-d665-a00a-009d" hidden="false" page="67" publicationId="4740-6730-10c0-9b25" typeId="584a-05fe-7c57-360c" typeName="Biomorphs">
      <characteristics>
        <characteristic name="Biomorphs" typeId="b4c3-8624-ebe7-241c">Any hits the creature inflicts in close combat cause D3 damage</characteristic>
      </characteristics>
    </profile>
    <profile name="Voltage Field" id="d5eb-113b-6747-b078" hidden="false" page="67" publicationId="4740-6730-10c0-9b25" typeId="584a-05fe-7c57-360c" typeName="Biomorphs">
      <characteristics>
        <characteristic name="Biomorphs" typeId="b4c3-8624-ebe7-241c">The creature gains an additional saving throw of 4+ which is not affected by modifiers.
If the creature is within 4&quot; of a force field of any kind the voltage field will burn it out on a 4+ making it useless for the rest of the battle.
The creature gains +1 Strength in close combat</characteristic>
      </characteristics>
    </profile>
    <profile name="Warp Field" id="f9c8-9293-a5b1-917a" hidden="false" page="67" publicationId="4740-6730-10c0-9b25" typeId="584a-05fe-7c57-360c" typeName="Biomorphs">
      <characteristics>
        <characteristic name="Biomorphs" typeId="b4c3-8624-ebe7-241c">Roll 2D6 against each attack that hits the creature. If the roll beats the Strength value of the attack the psychic shield stops it harming the creature in any way. If the 2D6 roll is equal to or less than the strength of the attack it pierces the shield and make a wound roll and armour saves as normal
Weapons without a Strength value count as Strength 6
Only protects against psychic powers which make an attack using a Strength value</characteristic>
      </characteristics>
    </profile>
    <profile name="Hive Tyrant" id="82a0-d7ee-6f97-8195" hidden="false" page="68" publicationId="4740-6730-10c0-9b25" typeId="219f-0faa-a2d8-f766" typeName="Unit">
