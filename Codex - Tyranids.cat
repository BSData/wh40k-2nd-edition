        <infoLink name="Leadership" id="4025-6aee-f36c-6192" hidden="false" targetId="029d-d831-ac7e-79df" type="rule"/>
      </infoLinks>
      <profiles>
        <profile name="Tyranid" id="f209-9d0d-9d96-7b0b" hidden="false" page="26" publicationId="4740-6730-10c0-9b25" typeId="7918-e0ef-71e7-a7fd" typeName="Spore Mine Damage">
          <characteristics>
            <characteristic name="Strength" typeId="966c-3d59-956d-d12c">5</characteristic>
            <characteristic name="Damage" typeId="f5ce-ce7b-f3b0-19d1">1</characteristic>
            <characteristic name="Save Modifier" typeId="6e5f-126e-f5ac-c49a">0</characteristic>
            <characteristic name="Armour Penetration" typeId="0f77-6c11-7871-379d">-</characteristic>
          </characteristics>
        </profile>
        <profile name="Vehicle / Building" id="5cd5-54b9-b06f-e4e3" hidden="false" page="26" publicationId="4740-6730-10c0-9b25" typeId="7918-e0ef-71e7-a7fd" typeName="Spore Mine Damage">
          <characteristics>
            <characteristic name="Strength" typeId="966c-3d59-956d-d12c">-</characteristic>
            <characteristic name="Damage" typeId="f5ce-ce7b-f3b0-19d1">-</characteristic>
            <characteristic name="Save Modifier" typeId="6e5f-126e-f5ac-c49a">-</characteristic>
            <characteristic name="Armour Penetration" typeId="0f77-6c11-7871-379d">10+2D3+D6</characteristic>
          </characteristics>
        </profile>
        <profile name="Non Tyranid" id="a6ce-7ea0-7a59-c248" hidden="false" page="26" publicationId="4740-6730-10c0-9b25" typeId="7918-e0ef-71e7-a7fd" typeName="Spore Mine Damage">
          <characteristics>
            <characteristic name="Strength" typeId="966c-3d59-956d-d12c">5</characteristic>
            <characteristic name="Damage" typeId="f5ce-ce7b-f3b0-19d1">D3</characteristic>
            <characteristic name="Save Modifier" typeId="6e5f-126e-f5ac-c49a">-2</characteristic>
            <characteristic name="Armour Penetration" typeId="0f77-6c11-7871-379d">-</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Spore Mine Movement" id="7a03-d787-e4a6-25c2" hidden="false" page="26" publicationId="4740-6730-10c0-9b25">
          <description>Spore mines move 2D6&quot; in the Tyranid movement phase in a random direction by using the Scatter dice. They drift over obstacles in their path and ignore any terrain modifiers</description>
        </rule>
        <rule name="Spore Mine Detonation" id="0b78-bea0-2174-4c8c" hidden="false" page="26" publicationId="4740-6730-10c0-9b25">
          <description>A spore mine detonates if it moves within 1&quot; of a non-Tyranid model at any point during its movement.
If a spore mine is reduced to 0 wounds it explodes in place

If a vehicle is penetrating by a sproe mine hit place a marker on the vehicle. On each subsequent Tyranid turn roll 2 dice - 1 determines the location that is damaged, the 2nd is the damage roll. If you roll doubles, the infection stops spreading and resolve that final damage.
Crewman hit by the spreading rot take their armour save or suffer 1 wound</description>
        </rule>
        <rule name="Spore Mine Victory Points" id="b359-068a-f5f4-1e70" hidden="false" page="26" publicationId="4740-6730-10c0-9b25">
          <description>Worth 0 victory points if they are destroyed.</description>
        </rule>
      </rules>
    </selectionEntry>
