    <profile name="Hormagaunt" id="53a2-b04b-1d50-85b6" hidden="false" page="71" publicationId="4740-6730-10c0-9b25" typeId="219f-0faa-a2d8-f766" typeName="Unit">
      <characteristics>
        <characteristic name="Unit Type" typeId="49de-956f-8797-7436">Hormagaunt</characteristic>
