      <rules>
        <rule name="Acid Jet" id="6322-1f77-a5f7-7739" hidden="false" publicationId="4740-6730-10c0-9b25">
          <description>If the Haruspex scores a hit on an enemy model, other models nearby may be splashed with acid. Roll a D6 for any models within 3&quot; of the model hit by the acid jet. On a D6 roll of 4+ they are splattered with a small amount of acid and suffer an S5 hit with D3 Damage and a -2 save modifier</description>
        </rule>
      </rules>
    </selectionEntry>
