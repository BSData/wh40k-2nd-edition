    <rule name="Squat Heavy Bike Damage Table" id="f2aa-409e-261f-77b5" hidden="false" page="datafax" publicationId="9f92-b7df-cf75-9a46">
      <description>1-3: Crew*
4-6: Bike
See datafax for damage table
Hit the one nearest the Attack</description>
    </rule>
    <rule name="Rhino Damage Table" id="64ec-12df-30fd-8457" hidden="false" page="Datafax">
      <description>1: Track - Closest track to shooter
2-5: Hull
6: Weapons
See datafax for damage table</description>
    </rule>
    <rule name="Rhino Damage Table" id="d44d-6e87-98d8-44e9" hidden="false" page="Datafax">
      <description>1: Track - Closest track to shooter
2-5: Hull
6: Weapons
See datafax for damage table</description>
    </rule>
    <rule name="Land Raider Damage Table" id="d927-6e09-d144-c24e" hidden="false" page="Datafax">
      <description>1-2: Track - Hit closest to shooter
3-5: Hull
6: Lascannon - Hit closest to shooter
See datafax for damage table</description>
    </rule>
  </sharedRules>
